package output

import "std/strconv"

func system(command cstring) int
func fopen(filename cstring, mode cstring) *byte
func fclose(file *byte) int

const outputDirectory string = "output"
const outputPrefix string = "renga_"
const outputSuffix string = ".webp"

func zeroPad5(value int) string {
    text := strconv.Itoa(value)
    for len(text) < 5 { text = "0" + text }
    return text
}

func imagePath(number int) string {
    return outputDirectory + "/" + outputPrefix + zeroPad5(number) + outputSuffix
}

func imageExists(number int) bool {
    file := fopen(cstring(imagePath(number)), cstring("rb"))
    if file == nil { return false }
    fclose(file)
    return true
}

// NextImagePath creates the output directory and returns the next sequential
// filename after scanning existing renga_#####.webp files.
func NextImagePath() string {
    paths := NextImagePaths(1)
    if len(paths) == 0 { return outputDirectory + "/" + outputPrefix + "00001" + outputSuffix }
    return paths[0]
}

// NextImagePaths returns sequential output paths for a batch of images.
func NextImagePaths(count int) []string {
    if count <= 0 { return []string{} }
    system(cstring("if not exist output mkdir output"))
    maximum := 0
    for number := 1; number <= 99999; number++ {
        if imageExists(number) && number > maximum { maximum = number }
    }
    paths := make([]string, count)
    for i := 0; i < count; i++ {
        paths[i] = imagePath(maximum + 1 + i)
    }
    return paths
}
