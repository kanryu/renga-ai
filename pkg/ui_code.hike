const Source string = "import { Button, LineEdit, ListView, TextEdit, VerticalBox } from \"std-widgets.slint\";\n\n// --- renga/router.slint ---\nexport global AppRouter {\n    in-out property <string> current_page: \"Workflow\";\n    in-out property <length> ctx_node_x: 40px;\n    in-out property <length> ctx_node_y: 120px;\n    in-out property <length> generate_node_x: 500px;\n    in-out property <length> generate_node_y: 120px;\n    in-out property <length> sample_node_x: 50px;\n    in-out property <length> sample_node_y: 480px;\n    in-out property <length> imggen_node_x: 320px;\n    in-out property <length> imggen_node_y: 390px;\n    in-out property <length> save_node_x: 920px;\n    in-out property <length> save_node_y: 125px;\n    in-out property <length> detector_node_x: 40px;\n    in-out property <length> detector_node_y: 650px;\n    in-out property <length> detail_node_x: 760px;\n    in-out property <length> detail_node_y: 650px;\n    in-out property <length> ctx_node_width: 230px;\n    in-out property <length> ctx_node_height: 162px;\n    in-out property <length> sample_node_width: 230px;\n    in-out property <length> sample_node_height: 162px;\n    in-out property <length> imggen_node_width: 230px;\n    in-out property <length> imggen_node_height: 220px;\n    in-out property <length> generate_node_width: 230px;\n    in-out property <length> generate_node_height: 162px;\n    in-out property <length> save_node_width: 230px;\n    in-out property <length> save_node_height: 280px;\n    in-out property <length> detector_node_width: 230px;\n    in-out property <length> detector_node_height: 162px;\n    in-out property <length> detail_node_width: 230px;\n    in-out property <length> detail_node_height: 360px;\n    in-out property <string> checkpoint_path: \"Illustrious-XL-v2.0.safetensors\";\n    in-out property <string> diffusion_model_path: \"anima-aesthetic-v1.1.safetensors\";\n    in-out property <string> external_vae_path: \"Optional / embedded\";\n    in-out property <string> vae_path: \"qwen_image_vae.safetensors\";\n    in-out property <string> text_encoder_path: \"qwen_3_06b_base.safetensors\";\n    in-out property <string> clip_l_path: \"\";\n    in-out property <string> t5xxl_path: \"\";\n    in-out property <string> separated_models: \"false\";\n    in-out property <string> backend: \"diffusion=cuda0,detector=cuda0\";\n    in-out property <string> threads: \"Auto\";\n    in-out property <string> wtype: \"FP16\";\n    in-out property <string> flash_attn: \"false\";\n    in-out property <string> max_vram: \"Automatic\";\n    in-out property <string> sample_method: \"Euler\";\n    in-out property <string> scheduler: \"Karras\";\n    in-out property <string> sample_steps: \"20\";\n    in-out property <string> cfg: \"6.0\";\n    in-out property <string> eta: \"0.0\";\n    in-out property <string> flow_shift: \"1.0\";\n    in-out property <string> custom_sigmas: \"Default\";\n    in-out property <string> prompt: \"masterpiece, best quality, highres, detailed background\";\n    in-out property <string> negative_prompt: \"blurry, low quality\";\n    in-out property <string> width: \"1024\";\n    in-out property <string> height: \"1344\";\n    in-out property <string> batch_count: \"1\";\n    in-out property <string> seed: \"Random\";\n    in-out property <string> loras: \"None\";\n    in-out property <string> hires_cache: \"Default\";\n    in-out property <string> detector_model_path: \"face_yolov8m-face.safetensors\";\n    in-out property <string> detector_extra_args: \"confidence=0.05,mask_blur=4,inpaint_padding=32\";\n    in-out property <string> detail_prompt: \"detailed face, detailed eyes, beautiful eyes, sharp facial features, high quality\";\n    in-out property <string> detail_negative_prompt: \"blurry face, deformed face, bad eyes, low quality\";\n    in-out property <string> inpaint_width: \"512\";\n    in-out property <string> inpaint_height: \"512\";\n    in-out property <string> inpaint_strength: \"0.4\";\n    in-out property <string> generated_image_path: \"\";\n    in-out property <[image]> output_images: [];\n    in-out property <bool> image_preview_open: false;\n    in-out property <int> image_preview_index: 0;\n    in-out property <bool> workflow_running: false;\n    in-out property <string> workflow_stage: \"Ready\";\n    in-out property <int> workflow_step: 0;\n    in-out property <int> workflow_steps: 1;\n    in-out property <int> workflow_overall_step: 0;\n    in-out property <int> workflow_overall_steps: 100;\n    callback navigate(string);\n    callback open_file(string);\n    callback save_workflow();\n    callback run_workflow();\n    navigate(route) => { current_page = route; }\n}\n\nexport global WorkflowNodes {\n    in-out property <[string]> node_ids: [];\n    in-out property <[string]> node_types: [];\n    in-out property <string> selected_id: \"\";\n    in-out property <bool> ctx_to_generate: true;\n    in-out property <bool> sample_to_generate: true;\n    in-out property <bool> imggen_to_generate: true;\n    in-out property <bool> generate_to_detail: true;\n    in-out property <bool> detector_to_detail: true;\n    in-out property <bool> detail_to_save: true;\n    in-out property <bool> generate_to_save: false;\n    callback open_node(string);\n    callback cancel_edit();\n}\n\n// --- views/home_page.slint ---\ncomponent HomePage inherits Rectangle {\n\n    VerticalBox {\n        alignment: center;\n        spacing: 12px;\n        Text { text: \"Renga AI\"; font-size: 28px; horizontal-alignment: center; }\n        Text { text: \"Multimodal AI Workflow Studio\"; horizontal-alignment: center; }\n        Button { text: \"Open Workflow\"; clicked => { AppRouter.navigate(\"Workflow\"); } }\n        Button { text: \"Model Library\"; clicked => { AppRouter.navigate(\"Models\"); } }\n        Button { text: \"Settings\"; clicked => { AppRouter.navigate(\"Settings\"); } }\n    }\n}\n\n// --- views/models_page.slint ---\ncomponent ModelsPage inherits VerticalBox {\n    in-out property <[string]> models: [];\n    alignment: center;\n    spacing: 12px;\n    Text {\n        text: \"Model Library\";\n        font-size: 24px;\n        horizontal-alignment: center;\n    }\n    ListView {\n        for model_name in root.models: Text {\n            text: model_name;\n            horizontal-alignment: center;\n        }\n    }\n    Button {\n        text: \"Back to Home\";\n        clicked => { AppRouter.navigate(\"Home\"); }\n    }\n}\n\n// --- views/node_windows/node_panel.slint ---\nexport component NodePanel inherits Rectangle {\n    in property <string> node_title;\n    in property <string> node_kind;\n    in property <string> summary_line_1: \"\";\n    in property <string> summary_line_2: \"\";\n    in property <string> summary_line_3: \"\";\n    in property <string> summary_line_4: \"\";\n    in property <string> summary_line_5: \"\";\n    in property <string> summary_line_6: \"\";\n    in property <string> summary_label_1: \"\";\n    in property <string> summary_label_2: \"\";\n    in property <string> summary_label_3: \"\";\n    in property <string> summary_label_4: \"\";\n    in property <string> summary_label_5: \"\";\n    in property <string> summary_label_6: \"\";\n    in property <bool> show_line_labels: false;\n    in property <length> summary_line_1_height: 26px;\n    in property <length> summary_line_2_height: 26px;\n    in property <length> summary_line_3_height: 26px;\n    in property <length> summary_line_4_height: 26px;\n    in property <length> summary_line_5_height: 26px;\n    in property <length> summary_line_6_height: 26px;\n    in property <int> body_line_count: 3;\n    in property <int> input_count: 1;\n    in property <color> input_1_color: root.accent_color;\n    in property <color> input_2_color: root.accent_color;\n    in property <color> input_3_color: root.accent_color;\n    in property <string> input_1_label: \"\";\n    in property <string> input_2_label: \"\";\n    in property <string> input_3_label: \"\";\n    in property <string> input_1_type: \"\";\n    in property <string> input_2_type: \"\";\n    in property <string> input_3_type: \"\";\n    in property <color> accent_color;\n    in property <color> output_pin_color: root.accent_color;\n    in property <string> output_pin_label: \"\";\n    in property <string> output_pin_type: \"\";\n    in property <bool> show_output_pin: true;\n    in property <[image]> preview_images: [];\n    in property <bool> show_image_preview: false;\n    in-out property <length> node_x: 0px;\n    in-out property <length> node_y: 0px;\n    in-out property <length> node_width: 230px;\n    in-out property <length> node_height: 154px;\n    callback open;\n    out property <length> in_pin_1_x: root.node_x;\n    out property <length> pin_center_y: root.input_count >= 2 ? root.node_height / 2 + 9px : root.node_height / 2;\n    out property <length> in_pin_1_y: root.node_y + (root.input_count >= 2 ? root.pin_center_y - 28px : root.pin_center_y);\n    out property <length> in_pin_2_x: root.node_x;\n    out property <length> in_pin_2_y: root.node_y + root.pin_center_y;\n    out property <length> in_pin_3_x: root.node_x;\n    out property <length> in_pin_3_y: root.node_y + root.pin_center_y + 28px;\n    out property <length> out_pin_x: root.node_x + root.width;\n    out property <length> out_pin_y: root.node_y + root.pin_center_y;\n    property <length> row_1_y: root.show_line_labels ? 64px : 50px;\n    property <length> row_2_y: root.show_line_labels ? root.row_1_y + root.summary_line_1_height + 20px : 82px;\n    property <length> row_3_y: root.show_line_labels ? root.row_2_y + root.summary_line_2_height + (root.summary_label_3 != \"\" ? 20px : 8px) : 114px;\n    property <length> row_4_y: root.show_line_labels ? root.row_3_y + root.summary_line_3_height + (root.summary_label_4 != \"\" ? 20px : 8px) : 146px;\n    property <length> row_5_y: root.show_line_labels ? root.row_4_y + root.summary_line_4_height + (root.summary_label_5 != \"\" ? 20px : 8px) : 178px;\n    property <length> row_6_y: root.show_line_labels ? root.row_5_y + root.summary_line_5_height + (root.summary_label_6 != \"\" ? 20px : 8px) : 210px;\n    property <int> preview_columns: root.preview_images.length <= 1 ? 1 : (root.preview_images.length <= 4 ? 2 : 3);\n    property <int> preview_rows: root.preview_images.length == 0 ? 1 : (root.preview_images.length + root.preview_columns - 1) / root.preview_columns;\n    property <length> preview_tile_width: (root.width - 32px) / root.preview_columns;\n    property <length> preview_tile_height: root.summary_line_1_height / root.preview_rows;\n    x: root.node_x; y: root.node_y; width: root.node_width; height: root.node_height;\n    background: #202024; border-width: 1px; border-color: #3f3f46; border-radius: 8px;\n    Rectangle { x: 0px; y: 0px; width: 100%; height: 38px; background: root.accent_color; border-radius: 8px; Text { x: 14px; y: 9px; text: root.node_title; color: #ffffff; font-size: 15px; font-weight: 700; } }\n    Text { x: 16px; y: root.row_1_y - 18px; text: root.summary_label_1; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_1 != \"\"; }\n    Text { x: 16px; y: root.row_2_y - 18px; text: root.summary_label_2; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_2 != \"\"; }\n    Text { x: 16px; y: root.row_3_y - 18px; text: root.summary_label_3; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_3 != \"\"; }\n    Text { x: 16px; y: root.row_4_y - 18px; text: root.summary_label_4; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_4 != \"\"; }\n    Text { x: 16px; y: root.row_5_y - 18px; text: root.summary_label_5; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_5 != \"\"; }\n    Text { x: 16px; y: root.row_6_y - 18px; text: root.summary_label_6; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_6 != \"\"; }\n    Rectangle { x: 16px; y: root.row_1_y; width: parent.width - 32px; height: root.summary_line_1_height; background: #121214; border-radius: 4px; clip: true;\n        Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_1; color: #e4e4e7; font-size: 12px; wrap: word-wrap; visible: !root.show_image_preview || root.preview_images.length == 0; }\n        for image[index] in root.preview_images: Rectangle {\n            x: ((root.preview_images.length == 3 && index == 2) ? 1 : Math.mod(index, root.preview_columns)) * root.preview_tile_width;\n            y: Math.floor(index / root.preview_columns) * root.preview_tile_height;\n            width: root.preview_tile_width;\n            height: root.preview_tile_height;\n            visible: root.show_image_preview;\n            Image { width: parent.width; height: parent.height; source: image; image-fit: contain; }\n            TouchArea { mouse-cursor: pointer; clicked => { AppRouter.image_preview_index = index; AppRouter.image_preview_open = true; } }\n        }\n    }\n    Rectangle { x: 16px; y: root.row_2_y; width: parent.width - 32px; height: root.summary_line_2_height; background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 2 && root.summary_line_2 != \"\"; Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_2; color: #e4e4e7; font-size: 12px; wrap: word-wrap; } }\n    Rectangle { x: 16px; y: root.row_3_y; width: parent.width - 32px; height: root.summary_line_3_height; background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 3 && root.summary_line_3 != \"\"; Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_3; color: #e4e4e7; font-size: 12px; wrap: word-wrap; } }\n    Rectangle { x: 16px; y: root.row_4_y; width: parent.width - 32px; height: root.summary_line_4_height; background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 4 && root.summary_line_4 != \"\"; Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_4; color: #e4e4e7; font-size: 12px; wrap: word-wrap; } }\n    Rectangle { x: 16px; y: root.row_5_y; width: parent.width - 32px; height: root.summary_line_5_height; background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 5 && root.summary_line_5 != \"\"; Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_5; color: #e4e4e7; font-size: 12px; wrap: word-wrap; } }\n    Rectangle { x: 16px; y: root.row_6_y; width: parent.width - 32px; height: root.summary_line_6_height; background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 6 && root.summary_line_6 != \"\"; Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_6; color: #e4e4e7; font-size: 12px; wrap: word-wrap; } }\n    if root.input_count >= 1: Rectangle { x: -7px; y: root.in_pin_1_y - root.node_y - 7px; width: 14px; height: 14px; border-radius: 7px; background: root.input_1_color; }\n    if root.input_count >= 2: Rectangle { x: -7px; y: root.in_pin_2_y - root.node_y - 7px; width: 14px; height: 14px; border-radius: 7px; background: root.input_2_color; }\n    if root.input_count >= 3: Rectangle { x: -7px; y: root.in_pin_3_y - root.node_y - 7px; width: 14px; height: 14px; border-radius: 7px; background: root.input_3_color; }\n    if root.show_output_pin: Rectangle { x: root.node_width - 7px; y: root.out_pin_y - root.node_y - 7px; width: 14px; height: 14px; border-radius: 7px; background: root.output_pin_color; }\n    Text { x: -112px; y: root.in_pin_1_y - root.node_y - 8px; width: 98px; text: root.input_1_label; color: root.input_1_color; font-size: 11px; horizontal-alignment: right; visible: root.input_1_label != \"\"; }\n    Text { x: -112px; y: root.in_pin_2_y - root.node_y - 8px; width: 98px; text: root.input_2_label; color: root.input_2_color; font-size: 11px; horizontal-alignment: right; visible: root.input_2_label != \"\"; }\n    Text { x: -112px; y: root.in_pin_3_y - root.node_y - 8px; width: 98px; text: root.input_3_label; color: root.input_3_color; font-size: 11px; horizontal-alignment: right; visible: root.input_3_label != \"\"; }\n    Text { x: root.node_width + 14px; y: root.out_pin_y - root.node_y - 8px; width: 90px; text: root.output_pin_label; color: root.output_pin_color; font-size: 11px; visible: root.show_output_pin && root.output_pin_label != \"\"; }\n}\n\n// --- views/node_windows/workflow_nodes.slint ---\nexport component LoadModelNode inherits NodePanel {\n    node_x <=> AppRouter.ctx_node_x; node_y <=> AppRouter.ctx_node_y;\n    node_width <=> AppRouter.ctx_node_width; node_height <=> AppRouter.ctx_node_height;\n    node_title: \"Load Model\"; node_kind: \"Struct input\";\n    summary_line_1: AppRouter.separated_models == \"true\" ? \"diffusion: \" + AppRouter.diffusion_model_path : \"model: \" + AppRouter.checkpoint_path;\n    summary_line_2: AppRouter.separated_models == \"true\" ? \"vae: \" + AppRouter.vae_path + \" / text: \" + AppRouter.text_encoder_path : \"threads: \" + AppRouter.threads + \" / \" + AppRouter.wtype;\n    summary_line_3: \"Model context parameters\"; input_count: 0;\n    output_pin_label: \"Model\"; output_pin_type: \"Model\"; accent_color: #fb923c;\n}\n\nexport component GenerateImageNode inherits NodePanel {\n    node_x <=> AppRouter.generate_node_x; node_y <=> AppRouter.generate_node_y;\n    node_width <=> AppRouter.generate_node_width; node_height <=> AppRouter.generate_node_height;\n    node_title: \"Generate Image\"; node_kind: \"Image generation\";\n    summary_line_1: \"rendering: SDCTX + SDIMG\";\n    summary_line_2: \"size: \" + AppRouter.width + \" x \" + AppRouter.height;\n    summary_line_3: \"batch count: \" + AppRouter.batch_count; input_count: 3;\n    input_1_label: \"Prompt\"; input_2_label: \"Model\"; input_3_label: \"Sampler\";\n    input_1_type: \"Prompt\"; input_2_type: \"Model\"; input_3_type: \"Sampler\";\n    input_1_color: #facc15; input_2_color: #fb923c; input_3_color: #a78bfa;\n    output_pin_label: \"Image\"; output_pin_type: \"Image\"; output_pin_color: #65a9ff; accent_color: #65a9ff;\n}\n\nexport component SamplerSchedulerNode inherits NodePanel {\n    node_x <=> AppRouter.sample_node_x; node_y <=> AppRouter.sample_node_y;\n    node_width <=> AppRouter.sample_node_width; node_height <=> AppRouter.sample_node_height;\n    node_title: \"Sampler & Scheduler\"; node_kind: \"Struct input\";\n    summary_line_1: \"method: \" + AppRouter.sample_method;\n    summary_line_2: \"steps: \" + AppRouter.sample_steps + \" / scheduler: \" + AppRouter.scheduler + \" / CFG: \" + AppRouter.cfg;\n    summary_line_3: \"Sampler parameters\"; input_count: 0;\n    output_pin_label: \"Sampler\"; output_pin_type: \"Sampler\"; accent_color: #a78bfa;\n}\n\nexport component PromptNode inherits NodePanel {\n    node_x <=> AppRouter.imggen_node_x; node_y <=> AppRouter.imggen_node_y;\n    node_width <=> AppRouter.imggen_node_width; node_height <=> AppRouter.imggen_node_height;\n    node_title: \"Prompt\"; node_kind: \"Text prompt\";\n    summary_line_1: AppRouter.prompt; summary_line_2: AppRouter.negative_prompt;\n    summary_label_1: \"Positive Prompt\"; summary_label_2: \"Negative Prompt\";\n    summary_line_1_height: 64px; summary_line_2_height: 64px;\n    show_line_labels: true; body_line_count: 2; input_count: 0;\n    output_pin_label: \"Prompt\"; output_pin_type: \"Prompt\"; output_pin_color: #facc15; accent_color: #facc15;\n}\n\nexport component SaveImageNode inherits NodePanel {\n    node_x <=> AppRouter.save_node_x; node_y <=> AppRouter.save_node_y;\n    node_width <=> AppRouter.save_node_width; node_height <=> AppRouter.save_node_height;\n    node_title: \"Save Image\"; node_kind: \"Image output\";\n    summary_line_1: \"Generated images will be here\";\n    summary_line_1_height: 220px; body_line_count: 1;\n    show_image_preview: true; preview_images: AppRouter.output_images;\n    input_1_label: \"Image\"; input_1_type: \"Image\"; show_output_pin: false;\n    input_1_color: #65a9ff; accent_color: #65a9ff;\n}\n\nexport component LoadDetectorNode inherits NodePanel {\n    node_x <=> AppRouter.detector_node_x; node_y <=> AppRouter.detector_node_y;\n    node_width <=> AppRouter.detector_node_width; node_height <=> AppRouter.detector_node_height;\n    node_title: \"Load Detector\"; node_kind: \"ADetailer detector\";\n    summary_line_1: AppRouter.detector_model_path;\n    summary_line_2: \"backend: \" + AppRouter.backend;\n    summary_line_3: \"Face detection model\"; input_count: 0;\n    output_pin_label: \"Detector\"; output_pin_type: \"Detector\"; output_pin_color: #fb923c; accent_color: #fb923c;\n}\n\nexport component DetailImageNode inherits NodePanel {\n    node_x <=> AppRouter.detail_node_x; node_y <=> AppRouter.detail_node_y;\n    node_width <=> AppRouter.detail_node_width; node_height <=> AppRouter.detail_node_height;\n    node_title: \"Detail Image\"; node_kind: \"E-Detailer processing\";\n    summary_line_1: AppRouter.detail_prompt; summary_line_2: AppRouter.detail_negative_prompt;\n    summary_line_3: \"inpaint: \" + AppRouter.inpaint_width + \" x \" + AppRouter.inpaint_height;\n    summary_line_4: \"strength: \" + AppRouter.inpaint_strength + \" / confidence=0.05\";\n    summary_line_5: \"mask_blur=4 / inpaint_padding=32\"; summary_line_6: AppRouter.detector_extra_args;\n    summary_label_1: \"Positive Prompt\"; summary_label_2: \"Negative Prompt\";\n    summary_line_1_height: 64px; summary_line_2_height: 64px;\n    show_line_labels: true; body_line_count: 6; input_count: 2;\n    input_1_label: \"Image\"; input_2_label: \"Detector\";\n    input_1_type: \"Image\"; input_2_type: \"Detector\";\n    input_1_color: #65a9ff; input_2_color: #fb923c;\n    output_pin_label: \"Image\"; output_pin_type: \"Image\"; output_pin_color: #65a9ff; accent_color: #65a9ff;\n}\n\n// --- views/node_pages.slint ---\ncomponent NodePage inherits Rectangle {\n    in property <string> node_title;\n    in property <string> node_kind;\n    in property <string> node_description;\n    background: #20242c;\n    Rectangle {\n        x: 0px; y: 0px; width: 100%; height: 64px; background: #2a303b;\n        Text { x: 24px; y: 18px; text: root.node_title; color: #f5f7fa; font-size: 22px; }\n        Text { x: 24px; y: 43px; text: root.node_kind; color: #aeb7c6; font-size: 11px; }\n    }\n    Rectangle {\n        x: 672px; y: 14px; width: 34px; height: 34px;\n        border-radius: 17px; background: #454d5b;\n        Text { text: \"×\"; color: #ffffff; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }\n        TouchArea { clicked => { AppRouter.navigate(\"Workflow\"); } }\n    }\n    Button {\n        x: 540px; y: 14px; width: 118px; height: 34px;\n        text: \"Cancel\";\n        clicked => { WorkflowNodes.cancel_edit(); }\n    }\n    Text { x: 28px; y: 104px; text: root.node_description; color: #d7dce5; font-size: 15px; }\n    Rectangle { x: 28px; y: 142px; width: 664px; height: 1px; background: #414957; }\n    Text { x: 28px; y: 166px; text: \"Node parameters\"; color: #f5f7fa; font-size: 16px; }\n    Text { x: 28px; y: 198px; text: \"This editor will be extended with node-specific controls.\"; color: #9aa5b5; font-size: 13px; }\n}\n\nexport component PromptNodePage inherits NodePage {\n    node_title: \"Prompt Node\"; node_kind: \"Text input node\";\n    node_description: \"Create and refine the text prompt for the next node.\";\n}\n\nexport component DiffusionNodePage inherits NodePage {\n    node_title: \"Stable Diffusion Node\"; node_kind: \"Image generation node\";\n    node_description: \"Configure the image generation model and sampling options.\";\n}\n\nexport component PreviewNodePage inherits NodePage {\n    node_title: \"Image Preview Node\"; node_kind: \"Output node\";\n    node_description: \"Inspect the generated image and pass it to another node.\";\n}\n\ncomponent ParameterRow inherits Rectangle {\n    in property <string> parameter_name;\n    in property <string> parameter_value;\n    width: 320px;\n    height: 28px;\n    Text { x: 0px; y: 6px; text: root.parameter_name; color: #cbd3df; font-size: 13px; }\n    Rectangle { x: 170px; y: 0px; width: 150px; height: 28px; background: #303744; border-radius: 4px;\n        Text { x: 8px; y: 6px; text: root.parameter_value; color: #f5f7fa; font-size: 12px; }\n    }\n}\n\ncomponent EditorField inherits Rectangle {\n    in-out property <string> value;\n    in property <string> placeholder: \"\";\n    in property <length> field_width: 300px;\n    in property <color> field_background: #303744;\n    width: root.field_width;\n    height: 32px;\n    background: root.field_background;\n    border-width: 1px;\n    border-color: #465264;\n    border-radius: 4px;\n    LineEdit {\n        x: 10px;\n        y: 4px;\n        width: parent.width - 20px;\n        height: parent.height - 8px;\n        text <=> root.value;\n        font-size: 13px;\n    }\n}\n\ncomponent MultilineEditor inherits Rectangle {\n    in-out property <string> value;\n    in property <length> field_width: 470px;\n    in property <length> field_height: 92px;\n    width: root.field_width;\n    height: root.field_height;\n    background: #303744;\n    border-width: 1px;\n    border-color: #465264;\n    border-radius: 4px;\n    TextEdit {\n        x: 8px;\n        y: 6px;\n        width: parent.width - 16px;\n        height: parent.height - 12px;\n        text <=> root.value;\n        wrap: word-wrap;\n        font-size: 13px;\n        placeholder-text: \"Enter prompt...\";\n    }\n}\n\ncomponent EditorLabel inherits Rectangle {\n    in property <string> label;\n    width: 150px;\n    height: 32px;\n    Text { x: 0px; y: 8px; text: root.label; color: #cbd3df; font-size: 13px; }\n}\n\ncomponent FilePickerField inherits Rectangle {\n    in-out property <string> value;\n    in property <string> field_key;\n    in property <color> field_background: #263c3c;\n    width: 580px;\n    height: 32px;\n    EditorField {\n        x: 0px;\n        y: 0px;\n        value <=> root.value;\n        field_width: 460px;\n        field_background: root.field_background;\n    }\n    Button {\n        x: 470px;\n        y: 0px;\n        width: 110px;\n        height: 32px;\n        text: \"Browse...\";\n        clicked => { AppRouter.open_file(root.field_key); }\n    }\n}\n\ncomponent ModelSourceMode inherits Rectangle {\n    in property <string> mode_title;\n    in property <string> mode_description;\n    in property <bool> selected: false;\n    callback choose;\n    width: 300px;\n    height: 68px;\n    background: root.selected ? #3d618b : #29313d;\n    border-width: 1px;\n    border-color: root.selected ? #9acbff : #465264;\n    border-radius: 6px;\n    Text { x: 12px; y: 10px; text: root.mode_title; color: #f5f7fa; font-size: 13px; font-weight: 700; }\n    Text { x: 12px; y: 34px; text: root.mode_description; color: #aeb7c6; font-size: 11px; }\n    TouchArea { clicked => { root.choose(); } }\n}\n\ncomponent ParameterNodePage inherits NodePage {\n    in-out property <bool> show_advanced: false;\n    in property <string> section_title: \"Standard parameters\";\n    Text { x: 28px; y: 232px; text: root.section_title; color: #f5f7fa; font-size: 15px; }\n    Button { x: 540px; y: 228px; text: \"Show Advanced\"; visible: !root.show_advanced; clicked => { root.show_advanced = true; } }\n    Button { x: 540px; y: 228px; text: \"Hide Advanced\"; visible: root.show_advanced; clicked => { root.show_advanced = false; } }\n}\n\nexport component ContextParamsNodePage inherits ParameterNodePage {\n    in-out property <bool> separated_models: false;\n    callback browse_file(string);\n    node_title: \"Load Model\"; node_kind: \"Model context parameters\";\n    node_description: \"Choose whether the renderer uses a bundled checkpoint or separate model components.\";\n    section_title: \"Model source\";\n    ModelSourceMode {\n        x: 28px; y: 260px;\n        mode_title: \"Checkpoint (bundled)\";\n        mode_description: \"SDXL / Illustrious style checkpoint\";\n        selected: AppRouter.separated_models == \"false\";\n        choose => { AppRouter.separated_models = \"false\"; AppRouter.backend = \"diffusion=cuda0,detector=cuda0\"; }\n    }\n    ModelSourceMode {\n        x: 346px; y: 260px;\n        mode_title: \"Separated components\";\n        mode_description: \"Diffusion model + VAE + text encoders\";\n        selected: AppRouter.separated_models == \"true\";\n        choose => { AppRouter.separated_models = \"true\"; AppRouter.backend = \"diffusion=cuda0,te=cuda0,vae=cuda0\"; }\n    }\n    if AppRouter.separated_models == \"false\": EditorLabel { x: 28px; y: 350px; label: \"checkpoint_path\"; }\n    if AppRouter.separated_models == \"false\": FilePickerField { x: 190px; y: 350px; field_key: \"checkpoint_path\"; value <=> AppRouter.checkpoint_path; }\n    if AppRouter.separated_models == \"false\": EditorLabel { x: 28px; y: 390px; label: \"external_vae\"; }\n    if AppRouter.separated_models == \"false\": FilePickerField { x: 190px; y: 390px; field_key: \"external_vae_path\"; value <=> AppRouter.external_vae_path; }\n    if AppRouter.separated_models == \"true\": EditorLabel { x: 28px; y: 350px; label: \"diffusion_model\"; }\n    if AppRouter.separated_models == \"true\": FilePickerField { x: 190px; y: 350px; field_key: \"diffusion_model_path\"; value <=> AppRouter.diffusion_model_path; }\n    if AppRouter.separated_models == \"true\": EditorLabel { x: 28px; y: 390px; label: \"vae_path\"; }\n    if AppRouter.separated_models == \"true\": FilePickerField { x: 190px; y: 390px; field_key: \"vae_path\"; value <=> AppRouter.vae_path; }\n    if AppRouter.separated_models == \"true\": EditorLabel { x: 28px; y: 430px; label: \"text_encoder_path\"; }\n    if AppRouter.separated_models == \"true\": FilePickerField { x: 190px; y: 430px; field_key: \"text_encoder_path\"; value <=> AppRouter.text_encoder_path; }\n    EditorLabel { x: 28px; y: 510px; label: \"backend\"; }\n    EditorField { x: 190px; y: 510px; value <=> AppRouter.backend; field_width: 470px; }\n    EditorLabel { x: 28px; y: 550px; label: \"threads\"; }\n    EditorField { x: 190px; y: 550px; value <=> AppRouter.threads; field_width: 180px; }\n    EditorLabel { x: 390px; y: 550px; label: \"type\"; }\n    EditorField { x: 500px; y: 550px; value <=> AppRouter.wtype; field_width: 160px; }\n    EditorLabel { x: 28px; y: 590px; label: \"flash_attn\"; visible: root.show_advanced; }\n    EditorField { x: 190px; y: 590px; value <=> AppRouter.flash_attn; field_width: 180px; visible: root.show_advanced; }\n    EditorLabel { x: 390px; y: 590px; label: \"max_vram\"; visible: root.show_advanced; }\n    EditorField { x: 500px; y: 590px; value <=> AppRouter.max_vram; field_width: 160px; visible: root.show_advanced; }\n}\n\nexport component SampleParamsNodePage inherits ParameterNodePage {\n    node_title: \"Sampler & Scheduler\"; node_kind: \"Sampler parameters\";\n    node_description: \"Choose the sampler and guidance values for generation.\";\n    EditorLabel { x: 28px; y: 260px; label: \"sample_method\"; }\n    EditorField { x: 190px; y: 260px; value <=> AppRouter.sample_method; field_width: 180px; }\n    EditorLabel { x: 28px; y: 300px; label: \"scheduler\"; }\n    EditorField { x: 190px; y: 300px; value <=> AppRouter.scheduler; field_width: 180px; }\n    EditorLabel { x: 28px; y: 340px; label: \"sample_steps\"; }\n    EditorField { x: 190px; y: 340px; value <=> AppRouter.sample_steps; field_width: 180px; }\n    EditorLabel { x: 350px; y: 380px; label: \"cfg\"; }\n    EditorField { x: 500px; y: 380px; value <=> AppRouter.cfg; field_width: 160px; }\n    EditorLabel { x: 350px; y: 260px; label: \"eta\"; visible: root.show_advanced; }\n    EditorField { x: 500px; y: 260px; value <=> AppRouter.eta; field_width: 160px; visible: root.show_advanced; }\n    EditorLabel { x: 350px; y: 300px; label: \"flow_shift\"; visible: root.show_advanced; }\n    EditorField { x: 500px; y: 300px; value <=> AppRouter.flow_shift; field_width: 160px; visible: root.show_advanced; }\n    EditorLabel { x: 350px; y: 340px; label: \"custom_sigmas\"; visible: root.show_advanced; }\n    EditorField { x: 500px; y: 340px; value <=> AppRouter.custom_sigmas; field_width: 160px; visible: root.show_advanced; }\n}\n\nexport component ImageGenParamsNodePage inherits ParameterNodePage {\n    node_title: \"Prompt\"; node_kind: \"Text prompt\";\n    node_description: \"Set the positive and negative prompts for image generation.\";\n    section_title: \"Prompt text\";\n    EditorLabel { x: 28px; y: 260px; label: \"Positive Prompt\"; height: 92px; }\n    MultilineEditor { x: 190px; y: 260px; value <=> AppRouter.prompt; }\n    EditorLabel { x: 28px; y: 366px; label: \"Negative Prompt\"; height: 92px; }\n    MultilineEditor { x: 190px; y: 366px; value <=> AppRouter.negative_prompt; }\n}\n\nexport component LoadDetectorNodePage inherits ParameterNodePage {\n    node_title: \"Load Detector\"; node_kind: \"ADetailer detector\";\n    node_description: \"Load the face detector used by the E-Detailer pass.\";\n    section_title: \"Detector configuration\";\n    EditorLabel { x: 28px; y: 260px; label: \"detector_model\"; }\n    EditorField { x: 190px; y: 260px; value <=> AppRouter.detector_model_path; field_width: 470px; }\n    EditorLabel { x: 28px; y: 300px; label: \"threads\"; }\n    EditorField { x: 190px; y: 300px; value <=> AppRouter.threads; field_width: 180px; }\n    EditorLabel { x: 390px; y: 300px; label: \"backend\"; }\n    EditorField { x: 500px; y: 300px; value <=> AppRouter.backend; field_width: 160px; }\n    EditorLabel { x: 28px; y: 340px; label: \"params_backend\"; }\n    EditorField { x: 190px; y: 340px; value <=> AppRouter.backend; field_width: 470px; }\n}\n\ncomponent ProcessNodePage inherits NodePage {\n    in property <string> api_signature;\n    Text { x: 28px; y: 232px; text: \"Stable Diffusion API\"; color: #f5f7fa; font-size: 15px; }\n    Rectangle { x: 28px; y: 262px; width: 664px; height: 34px; background: #303744; border-radius: 4px;\n        Text { x: 12px; y: 8px; text: root.api_signature; color: #cbd3df; font-size: 12px; }\n    }\n    Text { x: 28px; y: 320px; text: \"Pins accept and produce typed workflow values.\"; color: #9aa5b5; font-size: 13px; }\n}\n\nexport component DetailImageNodePage inherits ProcessNodePage {\n    node_title: \"Detail Image\"; node_kind: \"E-Detailer processing\";\n    node_description: \"Detect faces and apply the ADetailer inpaint pass, falling back to the original image when no result is produced.\";\n    api_signature: \"sd.DetailImage(ctx, image, adetailer_params, inpaint_request) -> images\";\n    Text { x: 28px; y: 360px; text: \"Inpaint parameters\"; color: #f5f7fa; font-size: 15px; }\n    EditorLabel { x: 28px; y: 392px; label: \"width\"; }\n    EditorField { x: 190px; y: 392px; value <=> AppRouter.inpaint_width; field_width: 180px; }\n    EditorLabel { x: 390px; y: 392px; label: \"height\"; }\n    EditorField { x: 500px; y: 392px; value <=> AppRouter.inpaint_height; field_width: 160px; }\n    EditorLabel { x: 28px; y: 432px; label: \"strength\"; }\n    EditorField { x: 190px; y: 432px; value <=> AppRouter.inpaint_strength; field_width: 180px; }\n    EditorLabel { x: 28px; y: 472px; label: \"detail prompt\"; height: 52px; }\n    MultilineEditor { x: 190px; y: 472px; value <=> AppRouter.detail_prompt; }\n    EditorLabel { x: 28px; y: 578px; label: \"negative prompt\"; height: 52px; }\n    MultilineEditor { x: 190px; y: 578px; value <=> AppRouter.detail_negative_prompt; }\n    EditorLabel { x: 28px; y: 684px; label: \"extra AD args\"; }\n    EditorField { x: 190px; y: 684px; value <=> AppRouter.detector_extra_args; field_width: 470px; }\n}\n\nexport component GenerateImageNodePage inherits ProcessNodePage {\n    node_title: \"Generate Image\"; node_kind: \"Image generation\";\n    node_description: \"Generate an SD image from SDCTX and image generation parameters.\";\n    api_signature: \"SD_API bool generate_image(sd_ctx_t*, sd_img_gen_params_t*, sd_image_t**, int*)\";\n    Text { x: 28px; y: 360px; text: \"Rendering\"; color: #f5f7fa; font-size: 15px; }\n    EditorLabel { x: 28px; y: 392px; label: \"width\"; }\n    EditorField { x: 190px; y: 392px; value <=> AppRouter.width; field_width: 180px; }\n    EditorLabel { x: 390px; y: 392px; label: \"height\"; }\n    EditorField { x: 500px; y: 392px; value <=> AppRouter.height; field_width: 160px; }\n    EditorLabel { x: 28px; y: 432px; label: \"batch_count\"; }\n    EditorField { x: 190px; y: 432px; value <=> AppRouter.batch_count; field_width: 180px; }\n}\n\nexport component SaveWebPNodePage inherits ProcessNodePage {\n    node_title: \"Save Image\"; node_kind: \"Image output\";\n    node_description: \"Encode generated image data as a WebP file.\";\n    api_signature: \"sd.SaveWebP(*Image, path, quality) -> bool\";\n}\n\n// --- views/settings_page.slint ---\ncomponent SettingsPage inherits VerticalBox {\n    alignment: center;\n    spacing: 12px;\n    Text {\n        text: \"Settings\";\n        font-size: 24px;\n        horizontal-alignment: center;\n    }\n    Text {\n        text: \"Runtime and plugin settings will be configured here.\";\n        horizontal-alignment: center;\n    }\n    Button {\n        text: \"Back to Home\";\n        clicked => { AppRouter.navigate(\"Home\"); }\n    }\n}\n\n// --- views/workflow_page.slint ---\ncomponent GridBackground inherits Rectangle {\n    background: #171a20;\n    Image {\n        width: parent.width;\n        height: parent.height;\n        source: @image-url(\"E:/Home/src/golang/renga-ai/pkg/ui_code/grid_tile.png\");\n        image-fit: preserve;\n        horizontal-alignment: left;\n        v