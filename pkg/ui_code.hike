t: 40px;\n        mouse-cursor: root.wire_menu_visible ? default : crosshair;\n        pointer-event(event) => {\n            if event.kind == PointerEventKind.down {\n                root.wire_menu_visible = false;\n                root.wire_dragging = true; root.wire_source = 3;\n                root.wire_start_x = imggen_node.out_pin_x; root.wire_start_y = imggen_node.out_pin_y;\n                root.wire_end_x = imggen_node.out_pin_x; root.wire_end_y = imggen_node.out_pin_y;\n            }\n        }\n        moved => {\n            if root.wire_dragging {\n                root.wire_end_x = imggen_node.node_x + 210px + imggen_output_pin.mouse-x;\n                root.wire_end_y = imggen_node.node_y + 66px + imggen_output_pin.mouse-y;\n            }\n        }\n    }\n    BezierWire {\n        visible: root.wire_dragging;\n        start_x: root.wire_start_x;\n        start_y: root.wire_start_y;\n        end_x: root.wire_end_x;\n        end_y: root.wire_end_y;\n        wire_color: #f5f7fa;\n    }\n    Rectangle {\n        visible: root.wire_menu_visible;\n        x: root.wire_menu_x; y: root.wire_menu_y;\n        width: 150px; height: 42px;\n        background: #252a34; border-width: 1px; border-color: #667085; border-radius: 5px;\n        Text { x: 12px; y: 12px; text: \"Disconnect wire\"; color: #f5f7fa; font-size: 13px; }\n        TouchArea {\n            mouse-cursor: default;\n            clicked => {\n                if root.wire_menu_wire == 0 { root.ctx_to_generate = false; }\n                if root.wire_menu_wire == 1 { root.generate_to_detail = false; }\n                if root.wire_menu_wire == 2 { root.sample_to_generate = false; }\n                if root.wire_menu_wire == 3 { root.imggen_to_generate = false; }\n                if root.wire_menu_wire == 4 { root.detail_to_save = false; }\n                if root.wire_menu_wire == 5 { root.detector_to_detail = false; }\n                if root.wire_menu_wire == 6 { root.generate_to_save = false; }\n                root.wire_menu_visible = false;\n                root.wire_menu_wire = -1;\n            }\n        }\n    }\n    Rectangle {\n        visible: root.image_preview_open;\n        x: 0px; y: 0px; width: root.width; height: root.height;\n        background: #8080804d;\n    }\n    TouchArea {\n        visible: root.image_preview_open;\n        x: 0px; y: 0px; width: root.width; height: root.height;\n        mouse-cursor: default;\n        clicked => { root.image_preview_open = false; }\n    }\n    Image {\n        visible: root.image_preview_open;\n        x: 24px; y: 24px; width: root.width - 48px; height: root.height - 48px;\n        source: AppRouter.output_images[root.image_preview_index];\n        image-fit: contain;\n    }\n    TouchArea {\n        visible: root.image_preview_open;\n        x: 24px; y: 24px; width: root.width - 48px; height: root.height - 48px;\n        mouse-cursor: pointer;\n        clicked => { root.image_preview_open = false; }\n    }\n    Rectangle {\n        visible: AppRouter.workflow_running;\n        x: 18px;\n        y: parent.height - 92px;\n        width: parent.width - 36px;\n        height: 72px;\n        background: #20242cdd;\n        border-width: 1px;\n        border-color: #3f4652;\n        border-radius: 6px;\n        Text {\n            x: 12px; y: 8px; width: 260px; height: 18px;\n            text: AppRouter.workflow_stage;\n            color: #e5e7eb; font-size: 12px;\n        }\n        Text {\n            x: 280px; y: 8px; width: 120px; height: 18px;\n            text: AppRouter.workflow_step + \" / \" + AppRouter.workflow_steps;\n            color: #9ca3af; font-size: 11px;\n            horizontal-alignment: right;\n        }\n        Rectangle { x: 12px; y: 28px; width: parent.width - 24px; height: 8px; background: #11151b; border-radius: 4px;\n            Rectangle { x: 0px; width: parent.width * (AppRouter.workflow_steps > 0 ? AppRouter.workflow_step / AppRouter.workflow_steps : 0); height: 100%; background: #60a5fa; border-radius: 4px; }\n        }\n        Text {\n            x: 12px; y: 43px; width: 260px; height: 18px;\n            text: \"Overall progress\";\n            color: #9ca3af; font-size: 11px;\n        }\n        Text {\n            x: 280px; y: 43px; width: 120px; height: 18px;\n            text: AppRouter.workflow_overall_step + \"%\";\n            color: #9ca3af; font-size: 11px;\n            horizontal-alignment: right;\n        }\n        Rectangle { x: 12px; y: 62px; width: parent.width - 24px; height: 8px; background: #11151b; border-radius: 4px;\n            Rectangle { x: 0px; width: parent.width * (AppRouter.workflow_overall_steps > 0 ? AppRouter.workflow_overall_step / AppRouter.workflow_overall_steps : 0); height: 100%; background: #a78bfa; border-radius: 4px; }\n        }\n    }\n    Button {\n        x: parent.width - self.width - 24px;\n        y: 18px;\n        text: \"Back to Home\";\n        clicked => { AppRouter.navigate(\"Home\"); }\n    }\n    Button {\n        x: parent.width - self.width - 150px;\n        y: 18px;\n        text: \"Save Workflow\";\n        clicked => { AppRouter.save_workflow(); }\n    }\n    Button {\n        x: parent.width - self.width - 270px;\n        y: 18px;\n        text: \"Run\";\n        clicked => { AppRouter.run_workflow(); }\n    }\n}\n\n// --- router_view.slint ---\ncomponent RouterView inherits Rectangle {\n    in-out property <string> current_page <=> AppRouter.current_page;\n    in-out property <[string]> models <=> models_page.models;\n\n    if root.current_page == \"Home\": HomePage { width: 100%; height: 100%; }\n    if root.current_page == \"Workflow\": WorkflowPage { width: 100%; height: 100%; }\n    models_page := ModelsPage { visible: root.current_page == \"Models\"; width: 100%; height: 100%; }\n    if root.current_page == \"Settings\": SettingsPage { width: 100%; height: 100%; }\n    if root.current_page == \"NodePrompt\": PromptNodePage { width: 100%; height: 100%; }\n    if root.current_page == \"NodeDiffusion\": DiffusionNodePage { width: 100%; height: 100%; }\n    if root.current_page == \"NodePreview\": PreviewNodePage { width: 100%; height: 100%; }\n    if root.current_page == \"NodeContextParams\": ContextParamsNodePage { width: 100%; height: 100%; }\n    if root.current_page == \"NodeSampleParams\": SampleParamsNodePage { width: 100%; height: 100%; }\n    if root.current_page == \"NodeImageGenParams\": ImageGenParamsNodePage { width: 100%; height: 100%; }\n    if root.current_page == \"NodeLoadDetector\": LoadDetectorNodePage { width: 100%; height: 100%; }\n    if root.current_page == \"NodeDetailImage\": DetailImageNodePage { width: 100%; height: 100%; }\n    if root.current_page == \"NodeGenerateImage\": GenerateImageNodePage { width: 100%; height: 100%; }\n    if root.current_page == \"NodeSaveWebP\": SaveWebPNodePage { width: 100%; height: 100%; }\n}\n\n// --- app_window.slint ---\nexport component AppWindow inherits Window {\n    preferred-width: 1440px;\n    preferred-height: 880px;\n    min-width: 720px;\n    min-height: 440px;\n    title: \"Renga AI\";\n\n    in-out property <string> current_page <=> AppRouter.current_page;\n    in-out property <[string]> models <=> router.models;\n    router := RouterView { width: 100%; height: 100%; }\n}\n"