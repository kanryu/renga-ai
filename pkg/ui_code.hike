nerate_node.out_pin_y > detail_node.in_pin_1_y ? generate_node.out_pin_y : detail_node.in_pin_1_y) + 14px {\n                        root.wire_menu_wire = 1;\n                    } else if root.generate_to_save && drag_surface.mouse-x >= generate_node.out_pin_x - 12px && drag_surface.mouse-x <= save_node.in_pin_1_x + 12px && drag_surface.mouse-y >= (generate_node.out_pin_y < save_node.in_pin_1_y ? generate_node.out_pin_y : save_node.in_pin_1_y) - 14px && drag_surface.mouse-y <= (generate_node.out_pin_y > save_node.in_pin_1_y ? generate_node.out_pin_y : save_node.in_pin_1_y) + 14px {\n                        root.wire_menu_wire = 6;\n                    } else if root.detail_to_save && drag_surface.mouse-x >= detail_node.out_pin_x - 12px && drag_surface.mouse-x <= save_node.in_pin_1_x + 12px && drag_surface.mouse-y >= (detail_node.out_pin_y < save_node.in_pin_1_y ? detail_node.out_pin_y : save_node.in_pin_1_y) - 14px && drag_surface.mouse-y <= (detail_node.out_pin_y > save_node.in_pin_1_y ? detail_node.out_pin_y : save_node.in_pin_1_y) + 14px {\n                        root.wire_menu_wire = 4;\n                    } else if root.detector_to_detail && drag_surface.mouse-x >= detector_node.out_pin_x - 12px && drag_surface.mouse-x <= detail_node.in_pin_2_x + 12px && drag_surface.mouse-y >= (detector_node.out_pin_y < detail_node.in_pin_2_y ? detector_node.out_pin_y : detail_node.in_pin_2_y) - 14px && drag_surface.mouse-y <= (detector_node.out_pin_y > detail_node.in_pin_2_y ? detector_node.out_pin_y : detail_node.in_pin_2_y) + 14px {\n                        root.wire_menu_wire = 5;\n                    } else {\n                        root.wire_menu_wire = -1;\n                    }\n                    if root.wire_menu_wire >= 0 {\n                        root.wire_menu_x = drag_surface.mouse-x;\n                        root.wire_menu_y = drag_surface.mouse-y;\n                        root.wire_menu_visible = true;\n                    }\n                }\n          