package modelget

import "std/path"
import "std/strings"
import "std/maps"

type ModelComponent struct {
    Model string
    URL string
}

type ModelSet struct {
    Name string
    Family string
    Pipeline string
    Checkpoint ModelComponent
    Diffusion ModelComponent
    VAE ModelComponent
    TextEncoder ModelComponent
    Detector ModelComponent
    Params map[string]string
}

func fopen(filename cstring, mode cstring) *byte
func fclose(stream *byte) int
func fseek(stream *byte, offset int, origin int) int
func ftell(stream *byte) int
func fread(buffer *byte, size int, count int, stream *byte) int
func malloc(size int) *byte
func rename(oldPath cstring, newPath cstring) int
func remove(path cstring) int
func system(command cstring) int

const modelsDirectory string = "models"
const modelsManifest string = "models.toml"

func unquote(value string) string {
    result := strings.Trim(value, " \t\r")
    if strings.HasPrefix(result, "\"") && strings.HasSuffix(result, "\"") {
        return result[1:len(result)-1]
    }
    return result
}

func modelSetSectionName(line string) string {
    prefix := "[models.\""
    if !strings.HasPrefix(line, prefix) { return "" }
    remainder := line[len(prefix):len(line)]
    end := strings.Index(remainder, "\"]")
    if end < 0 { return "" }
    return remainder[0:end]
}

func storeModelSet(sets map[string]ModelSet, current ModelSet, active bool) {
    if active && current.Family != "" { sets[current.Family] = current }
}

// LoadModelSets reads the structured [models."..."] sections from
// models.toml. The returned map is keyed by the user-facing family value so
// the workflow can select a preset without knowing its component filenames.
func LoadModelSets() map[string]ModelSet {
    sets := make(map[string]ModelSet)
    manifest := readTextFile(modelsManifest)
    lines := strings.Split(manifest, "\n")
    current := ModelSet{}
    active := false

    for i := 0; i < len(lines); i = i + 1 {
        line := strings.Trim(lines[i], " \t\r")
        if line == "" || strings.HasPrefix(line, "#") { continue }
        sectionName := modelSetSectionName(line)
        if sectionName != "" {
            storeModelSet(sets, current, active)
            current = ModelSet{Name: sectionName, Params: make(map[string]string)}
            active = true
            continue
        }
        if !active { continue }
        separator := strings.Index(line, "=")
        if separator < 0 { continue }
        key := strings.Trim(line[0:separator], " \t\r")
        value := unquote(line[separator+1:len(line)])
        if key == "family" { current.Family = value }
        if key == "pipeline" { current.Pipeline = value }
        if key == "checkpoint.model" { current.Checkpoint.Model = value }
        if key == "checkpoint.url" { current.Checkpoint.URL = value }
        if key == "diffusion.model" { current.Diffusion.Model = value }
        if key == "diffusion.url" { current.Diffusion.URL = value }
        if key == "vae.model" { current.VAE.Model = value }
        if key == "vae.url" { current.VAE.URL = value }
        if key == "text_encoder.model" { current.TextEncoder.Model = value }
        if key == "text_encoder.url" { current.TextEncoder.URL = value }
        if key == "detector.model" { current.Detector.Model = value }
        if key == "detector.url" { current.Detector.URL = value }
        if strings.HasPrefix(key, "params.") {
            current.Params[key[7:len(key)]] = value
        }
    }
    storeModelSet(sets, current, active)
    return sets
}

func readTextFile(filename string) string {
    stream := fopen(cstring(filename), cstring("rb"))
    if stream == nil { return "" }
    fseek(stream, 0, 2)
    size := ftell(stream)
    fseek(stream, 0, 0)
    if size <= 0 { fclose(stream); return "" }
    buffer := malloc(size + 1)
    if buffer == nil { fclose(stream); return "" }
    fread(buffer, 1, size, stream)
    fclose(stream)
    buffer[size] = 0
    return string(buffer)
}

func modelURL(filename string) string {
    manifest := readTextFile(modelsManifest)
    lines := strings.Split(manifest, "\n")
    wanted := path.Base(strings.ReplaceAll(filename, "\\", "/"))
    // Preserve support for the original [models] filename = URL entries.
    for i := 0; i < len(lines); i = i + 1 {
        line := strings.Trim(lines[i], " \t\r")
        if line == "" || strings.HasPrefix(line, "#") || strings.HasPrefix(line, "[") { continue }
        separator := strings.Index(line, "=")
        if separator < 0 { continue }
        key := strings.Trim(line[0:separator], " \t\r")
        value := strings.Trim(line[separator+1:len(line)], " \t\r")
        if strings.HasPrefix(key, "\"") && strings.HasSuffix(key, "\"") { key = key[1:len(key)-1] }
        if strings.HasPrefix(value, "\"") && strings.HasSuffix(value, "\"") { value = value[1:len(value)-1] }
        if key == wanted { return value }
    }
    // Structured presets store metadata together with component pairs:
    // diffusion.model = "..."
    // diffusion.url = "..."
    // Search every preset for the requested component filename.
    for i := 0; i < len(lines); i = i + 1 {
        line := strings.Trim(lines[i], " \t\r")
        if line == "" || strings.HasPrefix(line, "#") || strings.HasPrefix(line, "[") { continue }
        separator := strings.Index(line, "=")
        if separator < 0 { continue }
        key := strings.Trim(line[0:separator], " \t\r")
        value := strings.Trim(line[separator+1:len(line)], " \t\r")
        if strings.HasPrefix(value, "\"") && strings.HasSuffix(value, "\"") { value = value[1:len(value)-1] }
        if !strings.HasSuffix(key, ".model") || value != wanted { continue }
        urlKey := key[0:len(key)-6] + ".url"
        for j := i + 1; j < len(lines); j = j + 1 {
            next := strings.Trim(lines[j], " \t\r")
            if strings.HasPrefix(next, "[") { break }
            nextSeparator := strings.Index(next, "=")
            if nextSeparator < 0 { continue }
            nextKey := strings.Trim(next[0:nextSeparator], " \t\r")
            nextValue := strings.Trim(next[nextSeparator+1:len(next)], " \t\r")
            if strings.HasPrefix(nextValue, "\"") && strings.HasSuffix(nextValue, "\"") { nextValue = nextValue[1:len(nextValue)-1] }
            if nextKey == urlKey { return nextValue }
        }
    }
    return ""
}

func IsAvailable(filename string) bool {
    normalized := path.Base(strings.ReplaceAll(filename, "\\", "/"))
    if normalized == "" || normalized == "." || normalized == "Optional / embedded" { return true }
    target := modelsDirectory + "/" + normalized
    stream := fopen(cstring(target), cstring("rb"))
    if stream == nil { return false }
    fclose(stream)
    return true
}

func urlFilename(url string) string {
    withoutQuery := url
    query := strings.Index(withoutQuery, "?")
    if query >= 0 { withoutQuery = withoutQuery[0:query] }
    return path.Base(withoutQuery)
}

// Ensure downloads one model named by the workflow into models/. The Windows
// curl -O option chooses the filename from the URL; when a manifest key uses a
// different local name, the downloaded file is renamed after the transfer.
func Ensure(filename string) bool {
    normalized := path.Base(strings.ReplaceAll(filename, "\\", "/"))
    if normalized == "" || normalized == "." || normalized == "Optional / embedded" { return true }
    if IsAvailable(normalized) { return true }

    url := modelURL(normalized)
    if url == "" { return false }

    system(cstring("if not exist models mkdir models"))
    downloaded := urlFilename(url)
    commandLine := "cd /d models && curl.exe -L -O --fail --retry 3 \"" + url + "\""
    if system(cstring(commandLine)) != 0 { return false }
    if downloaded == normalized { return IsAvailable(normalized) }

    if rename(cstring(modelsDirectory+"/"+downloaded), cstring(modelsDirectory+"/"+normalized)) != 0 {
        remove(cstring(modelsDirectory + "/" + downloaded))
        return false
    }
    return IsAvailable(normalized)
}

func EnsureModels(filenames []string) bool {
    for i := 0; i < len(filenames); i = i + 1 {
        if !Ensure(filenames[i]) { return false }
    }
    return true
}

// PrepareModels downloads missing workflow models and reports whether the
// caller must stop before starting the actual generation step.
// -1 means download failure, 0 means every model was already present, and 1
// means at least one model was downloaded successfully.
func PrepareModels(filenames []string) int {
    missing := false
    for i := 0; i < len(filenames); i = i + 1 {
        if !IsAvailable(filenames[i]) { missing = true }
    }
    if !EnsureModels(filenames) { return -1 }
    if missing { return 1 }
    return 0
}
