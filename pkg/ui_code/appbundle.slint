component LegacyNodePanel inherits Rectangle {
    in property <string> node_title;
    in property <string> node_kind;
    in property <string> summary_line_1: "";
    in property <string> summary_line_2: "";
    in property <string> summary_line_3: "";
    in property <string> summary_line_4: "";
    in property <string> summary_line_5: "";
    in property <string> summary_line_6: "";
    in property <string> summary_label_1: "";
    in property <string> summary_label_2: "";
    in property <string> summary_label_3: "";
    in property <string> summary_label_4: "";
    in property <string> summary_label_5: "";
    in property <string> summary_label_6: "";
    in property <bool> show_line_labels: false;
    in property <length> summary_line_1_height: 26px;
    in property <length> summary_line_2_height: 26px;
    in property <length> summary_line_3_height: 26px;
    in property <length> summary_line_4_height: 26px;
    in property <length> summary_line_5_height: 26px;
    in property <length> summary_line_6_height: 26px;
    in property <int> body_line_count: 3;
    in property <int> input_count: 1;
    in property <color> input_1_color: root.accent_color;
    in property <color> input_2_color: root.accent_color;
    in property <color> input_3_color: root.accent_color;
    in property <string> input_1_label: "";
    in property <string> input_2_label: "";
    in property <string> input_3_label: "";
    in property <color> accent_color;
    in property <color> output_pin_color: root.accent_color;
    in property <string> output_pin_label: "";
    in property <bool> show_output_pin: true;
    in-out property <length> node_x: 0px;
    in-out property <length> node_y: 0px;
    in-out property <length> node_width: 230px;
    in-out property <length> node_height: 154px;
    callback open;
    out property <length> in_pin_1_x: root.node_x;
    out property <length> pin_center_y: root.input_count >= 2 ? root.node_height / 2 + 9px : root.node_height / 2;
    out property <length> in_pin_1_y: root.node_y + (root.input_count >= 2 ? root.pin_center_y - 28px : root.pin_center_y);
    out property <length> in_pin_2_x: root.node_x;
    out property <length> in_pin_2_y: root.node_y + root.pin_center_y;
    out property <length> in_pin_3_x: root.node_x;
    out property <length> in_pin_3_y: root.node_y + root.pin_center_y + 28px;
    out property <length> out_pin_x: root.node_x + root.width;
    out property <length> out_pin_y: root.node_y + root.pin_center_y;
    property <length> row_1_y: root.show_line_labels ? 64px : 50px;
    property <length> row_2_y: root.show_line_labels ? root.row_1_y + root.summary_line_1_height + 20px : 82px;
    property <length> row_3_y: root.show_line_labels ? root.row_2_y + root.summary_line_2_height + (root.summary_label_3 != "" ? 20px : 8px) : 114px;
    property <length> row_4_y: root.show_line_labels ? root.row_3_y + root.summary_line_3_height + (root.summary_label_4 != "" ? 20px : 8px) : 146px;
    property <length> row_5_y: root.show_line_labels ? root.row_4_y + root.summary_line_4_height + (root.summary_label_5 != "" ? 20px : 8px) : 178px;
    property <length> row_6_y: root.show_line_labels ? root.row_5_y + root.summary_line_5_height + (root.summary_label_6 != "" ? 20px : 8px) : 210px;
    x: root.node_x;
    y: root.node_y;
    width: root.node_width; height: root.node_height; background: #202024;
    border-width: 1px; border-color: #3f3f46; border-radius: 8px;
    Rectangle {
        x: 0px; y: 0px; width: 100%; height: 38px;
        background: root.accent_color; border-radius: 8px;
        Text { x: 14px; y: 9px; text: root.node_title; color: #ffffff; font-size: 15px; font-weight: 700; }
    }
    Text { x: 16px; y: root.row_1_y - 18px; text: root.summary_label_1; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_1 != ""; }
    Text { x: 16px; y: root.row_2_y - 18px; text: root.summary_label_2; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_2 != ""; }
    Text { x: 16px; y: root.row_3_y - 18px; text: root.summary_label_3; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_3 != ""; }
    Text { x: 16px; y: root.row_4_y - 18px; text: root.summary_label_4; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_4 != ""; }
    Text { x: 16px; y: root.row_5_y - 18px; text: root.summary_label_5; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_5 != ""; }
    Text { x: 16px; y: root.row_6_y - 18px; text: root.summary_label_6; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_6 != ""; }
    Rectangle {
        x: 16px; y: root.row_1_y; width: parent.width - 32px; height: root.summary_line_1_height;
        background: #121214; border-radius: 4px; clip: true;
        Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_1; color: #e4e4e7; font-size: 12px; wrap: word-wrap; }
    }
    Rectangle {
        x: 16px; y: root.row_2_y; width: parent.width - 32px; height: root.summary_line_2_height;
        background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 2 && root.summary_line_2 != "";
        Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_2; color: #e4e4e7; font-size: 12px; wrap: word-wrap; }
    }
    Rectangle {
        x: 16px; y: root.row_3_y; width: parent.width - 32px; height: root.summary_line_3_height;
        background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 3 && root.summary_line_3 != "";
        Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_3; color: #e4e4e7; font-size: 12px; wrap: word-wrap; }
    }
    Rectangle {
        x: 16px; y: root.row_4_y; width: parent.width - 32px; height: root.summary_line_4_height;
        background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 4 && root.summary_line_4 != "";
        Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_4; color: #e4e4e7; font-size: 12px; wrap: word-wrap; }
    }
    Rectangle {
        x: 16px; y: root.row_5_y; width: parent.width - 32px; height: root.summary_line_5_height;
        background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 5 && root.summary_line_5 != "";
        Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_5; color: #e4e4e7; font-size: 12px; wrap: word-wrap; }
    }
    Rectangle {
        x: 16px; y: root.row_6_y; width: parent.width - 32px; height: root.summary_line_6_height;
        background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 6 && root.summary_line_6 != "";
        Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_6; color: #e4e4e7; font-size: 12px; wrap: word-wrap; }
    }
    if root.input_count >= 1: Rectangle { x: -7px; y: root.in_pin_1_y - root.node_y - 7px; width: 14px; height: 14px; border-radius: 7px; background: root.input_1_color; }
    if root.input_count >= 2: Rectangle { x: -7px; y: root.in_pin_2_y - root.node_y - 7px; width: 14px; height: 14px; border-radius: 7px; background: root.input_2_color; }
    if root.input_count >= 3: Rectangle { x: -7px; y: root.in_pin_3_y - root.node_y - 7px; width: 14px; height: 14px; border-radius: 7px; background: root.input_3_color; }
    if root.show_output_pin: Rectangle { x: root.node_width - 7px; y: root.out_pin_y - root.node_y - 7px; width: 14px; height: 14px; border-radius: 7px; background: root.output_pin_color; }
    Text { x: -112px; y: root.in_pin_1_y - root.node_y - 8px; width: 98px; text: root.input_1_label; color: root.input_1_color; font-size: 11px; horizontal-alignment: right; visible: root.input_1_label != ""; }
    Text { x: -112px; y: root.in_pin_2_y - root.node_y - 8px; width: 98px; text: root.input_2_label; color: root.input_2_color; font-size: 11px; horizontal-alignment: right; visible: root.input_2_label != ""; }
    Text { x: -112px; y: root.in_pin_3_y - root.node_y - 8px; width: 98px; text: root.input_3_label; color: root.input_3_color; font-size: 11px; horizontal-alignment: right; visible: root.input_3_label != ""; }
    Text { x: root.node_width + 14px; y: root.out_pin_y - root.node_y - 8px; width: 90px; text: root.output_pin_label; color: root.output_pin_color; font-size: 11px; visible: root.show_output_pin && root.output_pin_label != ""; }
}

component BezierWire inherits Path {
    in property <length> start_x;
    in property <length> start_y;
    in property <length> end_x;
    in property <length> end_y;
    in property <color> wire_color;
    x: 0px; y: 0px; width: 2048px; height: 2048px;
    viewbox-x: 0; viewbox-y: 0; viewbox-width: 2048; viewbox-height: 2048;
    property <float> sx: root.start_x / 1px;
    property <float> sy: root.start_y / 1px;
    property <float> ex: root.end_x / 1px;
    property <float> ey: root.end_y / 1px;
    property <float> dist_x: (root.ex > root.sx ? root.ex - root.sx : root.sx - root.ex);
    property <float> offset: (root.dist_x < 10.0 ? root.dist_x * 0.5 : (root.dist_x * 0.5 > 140.0 ? 140.0 : root.dist_x * 0.5));
    stroke: root.wire_color;
    stroke-width: 3.5px;
    MoveTo { x: root.sx; y: root.sy; }
    CubicTo {
        control-1-x: root.sx + root.offset; control-1-y: root.sy;
        control-2-x: root.ex - root.offset; control-2-y: root.ey;
        x: root.ex; y: root.ey;
    }
}

component NodePaletteItem inherits Rectangle {
    in property <string> item_name;
    callback drag_start(string, length, length);
    callback drag_move(length, length);
    callback drag_end(length, length);
    width: 228px; height: 34px;
    background: #252b35; border-width: 1px; border-color: #3d4654; border-radius: 4px;
    Text { x: 12px; y: 8px; text: root.item_name; color: #e5e7eb; font-size: 12px; }
    TouchArea {
        mouse-cursor: grab;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_start(root.item_name, 42px + root.x + self.mouse-x, root.y + self.mouse-y);
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                root.drag_end(42px + root.x + self.mouse-x, root.y + self.mouse-y);
            }
        }
        moved => {
            if self.pressed {
                root.drag_move(42px + root.x + self.mouse-x, root.y + self.mouse-y);
            }
        }
    }
}

export component WorkflowPage inherits Rectangle {
    in-out property <bool> dragging: false;
    in-out property <int> drag_node: -1;
    in-out property <length> drag_offset_x: 0px;
    in-out property <length> drag_offset_y: 0px;
    in-out property <bool> wire_dragging: false;
    in-out property <int> wire_source: -1;
    in-out property <length> wire_start_x: 0px;
    in-out property <length> wire_start_y: 0px;
    in-out property <length> wire_end_x: 0px;
    in-out property <length> wire_end_y: 0px;
    in-out property <bool> ctx_to_generate <=> WorkflowNodes.ctx_to_generate;
    in-out property <bool> sample_to_generate <=> WorkflowNodes.sample_to_generate;
    in-out property <bool> imggen_to_generate <=> WorkflowNodes.imggen_to_generate;
    in-out property <bool> generate_to_detail <=> WorkflowNodes.generate_to_detail;
    in-out property <bool> detector_to_detail <=> WorkflowNodes.detector_to_detail;
    in-out property <bool> detail_to_save <=> WorkflowNodes.detail_to_save;
    in-out property <bool> generate_to_save <=> WorkflowNodes.generate_to_save;
    in-out property <bool> ctx_to_generate2 <=> WorkflowNodes.ctx_to_generate2;
    in-out property <bool> sample_to_generate2 <=> WorkflowNodes.sample_to_generate2;
    in-out property <bool> imggen_to_generate2 <=> WorkflowNodes.imggen_to_generate2;
    in-out property <bool> generate_to_detail2 <=> WorkflowNodes.generate_to_detail2;
    in-out property <bool> detector_to_detail2 <=> WorkflowNodes.detector_to_detail2;
    in-out property <bool> detail_to_save2 <=> WorkflowNodes.detail_to_save2;
    in-out property <bool> generate_to_save2 <=> WorkflowNodes.generate_to_save2;
    in-out property <bool> wire_menu_visible: false;
    in-out property <int> wire_menu_wire: -1;
    in-out property <length> wire_menu_x: 0px;
    in-out property <length> wire_menu_y: 0px;
    in-out property <int> pressed_node: -1;
    in-out property <bool> node_panel_open: false;
    in-out property <length> node_panel_width: 260px;
    in-out property <bool> palette_dragging: false;
    in-out property <bool> palette_drop_consumed: false;
    in-out property <string> palette_drag_name: "";
    in-out property <length> palette_drag_x: 0px;
    in-out property <length> palette_drag_y: 0px;
    callback finish_palette_drop();
    finish_palette_drop => {
        if root.palette_drag_x > root.node_panel_width + 42px {
            WorkflowNodes.drop_x = Math.max(42px, root.palette_drag_x - 115px);
            WorkflowNodes.drop_y = Math.max(0px, root.palette_drag_y - 20px);
            WorkflowNodes.add_node(root.palette_drag_name);
        }
        root.palette_dragging = false;
        root.palette_drop_consumed = true;
        root.palette_drag_name = "";
    }
    in-out property <bool> image_preview_open <=> AppRouter.image_preview_open;
    in-out property <int> image_preview_index <=> AppRouter.image_preview_index;
    property <bool> cursor_over_title:
        (drag_surface.mouse-x >= ctx_node.node_x && drag_surface.mouse-x <= ctx_node.node_x + ctx_node.width && drag_surface.mouse-y >= ctx_node.node_y && drag_surface.mouse-y <= ctx_node.node_y + 38px)
        || (drag_surface.mouse-x >= generate_node.node_x && drag_surface.mouse-x <= generate_node.node_x + generate_node.width && drag_surface.mouse-y >= generate_node.node_y && drag_surface.mouse-y <= generate_node.node_y + 38px)
        || (drag_surface.mouse-x >= sample_node.node_x && drag_surface.mouse-x <= sample_node.node_x + sample_node.width && drag_surface.mouse-y >= sample_node.node_y && drag_surface.mouse-y <= sample_node.node_y + 38px)
        || (drag_surface.mouse-x >= imggen_node.node_x && drag_surface.mouse-x <= imggen_node.node_x + imggen_node.width && drag_surface.mouse-y >= imggen_node.node_y && drag_surface.mouse-y <= imggen_node.node_y + 38px)
        || (drag_surface.mouse-x >= save_node.node_x && drag_surface.mouse-x <= save_node.node_x + save_node.width && drag_surface.mouse-y >= save_node.node_y && drag_surface.mouse-y <= save_node.node_y + 38px)
        || (drag_surface.mouse-x >= detector_node.node_x && drag_surface.mouse-x <= detector_node.node_x + detector_node.width && drag_surface.mouse-y >= detector_node.node_y && drag_surface.mouse-y <= detector_node.node_y + 38px)
        || (drag_surface.mouse-x >= detail_node.node_x && drag_surface.mouse-x <= detail_node.node_x + detail_node.width && drag_surface.mouse-y >= detail_node.node_y && drag_surface.mouse-y <= detail_node.node_y + 38px);
    property <bool> cursor_over_input:
        (drag_surface.mouse-x >= ctx_node.node_x + 16px && drag_surface.mouse-x <= ctx_node.node_x + ctx_node.width - 16px && drag_surface.mouse-y >= ctx_node.node_y + 50px && drag_surface.mouse-y <= ctx_node.node_y + 76px)
        || (drag_surface.mouse-x >= ctx_node.node_x + 16px && drag_surface.mouse-x <= ctx_node.node_x + ctx_node.width - 16px && drag_surface.mouse-y >= ctx_node.node_y + 82px && drag_surface.mouse-y <= ctx_node.node_y + 108px)
        || (drag_surface.mouse-x >= generate_node.node_x + 16px && drag_surface.mouse-x <= generate_node.node_x + generate_node.width - 16px && drag_surface.mouse-y >= generate_node.node_y + 50px && drag_surface.mouse-y <= generate_node.node_y + 76px)
        || (drag_surface.mouse-x >= generate_node.node_x + 16px && drag_surface.mouse-x <= generate_node.node_x + generate_node.width - 16px && drag_surface.mouse-y >= generate_node.node_y + 82px && drag_surface.mouse-y <= generate_node.node_y + 108px)
        || (drag_surface.mouse-x >= sample_node.node_x + 16px && drag_surface.mouse-x <= sample_node.node_x + sample_node.width - 16px && drag_surface.mouse-y >= sample_node.node_y + 50px && drag_surface.mouse-y <= sample_node.node_y + 76px)
        || (drag_surface.mouse-x >= sample_node.node_x + 16px && drag_surface.mouse-x <= sample_node.node_x + sample_node.width - 16px && drag_surface.mouse-y >= sample_node.node_y + 82px && drag_surface.mouse-y <= sample_node.node_y + 108px)
        || (drag_surface.mouse-x >= imggen_node.node_x + 16px && drag_surface.mouse-x <= imggen_node.node_x + imggen_node.width - 16px && drag_surface.mouse-y >= imggen_node.node_y + 50px && drag_surface.mouse-y <= imggen_node.node_y + 76px)
        || (drag_surface.mouse-x >= imggen_node.node_x + 16px && drag_surface.mouse-x <= imggen_node.node_x + imggen_node.width - 16px && drag_surface.mouse-y >= imggen_node.node_y + 82px && drag_surface.mouse-y <= imggen_node.node_y + 108px)
        || (drag_surface.mouse-x >= save_node.node_x + 16px && drag_surface.mouse-x <= save_node.node_x + save_node.width - 16px && drag_surface.mouse-y >= save_node.node_y + 50px && drag_surface.mouse-y <= save_node.node_y + 76px)
        || (drag_surface.mouse-x >= save_node.node_x + 16px && drag_surface.mouse-x <= save_node.node_x + save_node.width - 16px && drag_surface.mouse-y >= save_node.node_y + 82px && drag_surface.mouse-y <= save_node.node_y + 108px);
    background: #171a20;
    GridBackground { width: parent.width; height: parent.height; }
    Text { x: 18px; y: 14px; text: "Workflow / Untitled"; color: #f5f7fa; font-size: 18px; }
    Text { x: 18px; y: 40px; text: "Click a node to edit its parameters"; color: #8f9aaa; font-size: 12px; }
    BezierWire {
        visible: root.ctx_to_generate && ctx_node.visible && generate_node.visible;
        start_x: ctx_node.out_pin_x;
        start_y: ctx_node.out_pin_y;
        end_x: generate_node.in_pin_3_x;
        end_y: generate_node.in_pin_3_y;
        wire_color: #fb923c;
    }
    BezierWire {
        visible: root.generate_to_detail && generate_node.visible && detail_node.visible;
        start_x: generate_node.out_pin_x;
        start_y: generate_node.out_pin_y;
        end_x: detail_node.in_pin_1_x;
        end_y: detail_node.in_pin_1_y;
        wire_color: #65a9ff;
    }
    BezierWire {
        visible: root.generate_to_save && generate_node.visible && save_node.visible;
        start_x: generate_node.out_pin_x;
        start_y: generate_node.out_pin_y;
        end_x: save_node.in_pin_1_x;
        end_y: save_node.in_pin_1_y;
        wire_color: #65a9ff;
    }
    BezierWire {
        visible: root.imggen_to_generate && imggen_node.visible && generate_node.visible;
        start_x: imggen_node.out_pin_x;
        start_y: imggen_node.out_pin_y;
        end_x: generate_node.in_pin_1_x;
        end_y: generate_node.in_pin_1_y;
        wire_color: #facc15;
    }
    BezierWire {
        visible: root.sample_to_generate && sample_node.visible && generate_node.visible;
        start_x: sample_node.out_pin_x;
        start_y: sample_node.out_pin_y;
        end_x: generate_node.in_pin_2_x;
        end_y: generate_node.in_pin_2_y;
        wire_color: #a78bfa;
    }
    BezierWire {
        visible: root.detector_to_detail && detector_node.visible && detail_node.visible;
        start_x: detector_node.out_pin_x;
        start_y: detector_node.out_pin_y;
        end_x: detail_node.in_pin_2_x;
        end_y: detail_node.in_pin_2_y;
        wire_color: #fb923c;
    }
    BezierWire {
        visible: root.detail_to_save && detail_node.visible && save_node.visible;
        start_x: detail_node.out_pin_x;
        start_y: detail_node.out_pin_y;
        end_x: save_node.in_pin_1_x;
        end_y: save_node.in_pin_1_y;
        wire_color: #65a9ff;
    }
    BezierWire {
        visible: root.ctx_to_generate2 && ctx_node.visible && generate2_node.visible;
        start_x: ctx_node.out_pin_x; start_y: ctx_node.out_pin_y;
        end_x: generate2_node.in_pin_3_x; end_y: generate2_node.in_pin_3_y;
        wire_color: #fb923c;
    }
    BezierWire {
        visible: root.generate_to_detail2 && generate_node.visible && detail2_node.visible;
        start_x: generate_node.out_pin_x; start_y: generate_node.out_pin_y;
        end_x: detail2_node.in_pin_1_x; end_y: detail2_node.in_pin_1_y;
        wire_color: #65a9ff;
    }
    BezierWire {
        visible: root.generate_to_save2 && generate_node.visible && save2_node.visible;
        start_x: generate_node.out_pin_x; start_y: generate_node.out_pin_y;
        end_x: save2_node.in_pin_1_x; end_y: save2_node.in_pin_1_y;
        wire_color: #65a9ff;
    }
    BezierWire {
        visible: root.imggen_to_generate2 && imggen_node.visible && generate2_node.visible;
        start_x: imggen_node.out_pin_x; start_y: imggen_node.out_pin_y;
        end_x: generate2_node.in_pin_1_x; end_y: generate2_node.in_pin_1_y;
        wire_color: #facc15;
    }
    BezierWire {
        visible: root.sample_to_generate2 && sample_node.visible && generate2_node.visible;
        start_x: sample_node.out_pin_x; start_y: sample_node.out_pin_y;
        end_x: generate2_node.in_pin_2_x; end_y: generate2_node.in_pin_2_y;
        wire_color: #a78bfa;
    }
    BezierWire {
        visible: root.detector_to_detail2 && detector_node.visible && detail2_node.visible;
        start_x: detector_node.out_pin_x; start_y: detector_node.out_pin_y;
        end_x: detail2_node.in_pin_2_x; end_y: detail2_node.in_pin_2_y;
        wire_color: #fb923c;
    }
    BezierWire {
        visible: root.detail_to_save2 && detail_node.visible && save2_node.visible;
        start_x: detail_node.out_pin_x; start_y: detail_node.out_pin_y;
        end_x: save2_node.in_pin_1_x; end_y: save2_node.in_pin_1_y;
        wire_color: #65a9ff;
    }
    drag_surface := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: root.wire_menu_visible ? default : (root.cursor_over_title ? move : (root.cursor_over_input ? pointer : default));
        pointer-event(event) => {
            // The palette overlays this surface.  Do not let a drag that starts
            // on a palette item select or move the node underneath it.
            if root.node_panel_open && drag_surface.mouse-x < root.node_panel_width + 42px {
                return;
            }
            if root.palette_dragging || root.palette_drop_consumed {
                root.palette_drop_consumed = false;
                return;
            }
            if event.kind == PointerEventKind.down {
                root.wire_menu_visible = false;
                if event.button == PointerEventButton.right {
                    // The four current wires are routed between these node
                    // bounding boxes. This hit test deliberately includes a
                    // small margin so the thin Bezier stroke is easy to hit.
                    if root.ctx_to_generate && drag_surface.mouse-x >= ctx_node.out_pin_x - 12px && drag_surface.mouse-x <= generate_node.in_pin_3_x + 12px && drag_surface.mouse-y >= (ctx_node.out_pin_y < generate_node.in_pin_3_y ? ctx_node.out_pin_y : generate_node.in_pin_3_y) - 14px && drag_surface.mouse-y <= (ctx_node.out_pin_y > generate_node.in_pin_3_y ? ctx_node.out_pin_y : generate_node.in_pin_3_y) + 14px {
                        root.wire_menu_wire = 0;
                    } else if root.sample_to_generate && drag_surface.mouse-x >= sample_node.out_pin_x - 12px && drag_surface.mouse-x <= generate_node.in_pin_2_x + 12px && drag_surface.mouse-y >= (sample_node.out_pin_y < generate_node.in_pin_2_y ? sample_node.out_pin_y : generate_node.in_pin_2_y) - 14px && drag_surface.mouse-y <= (sample_node.out_pin_y > generate_node.in_pin_2_y ? sample_node.out_pin_y : generate_node.in_pin_2_y) + 14px {
                        root.wire_menu_wire = 2;
