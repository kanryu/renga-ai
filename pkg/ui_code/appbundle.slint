    in-out property <length> wire_menu_y: 0px;
    in-out property <int> pressed_node: -1;
    property <bool> cursor_over_title:
        (drag_surface.mouse-x >= ctx_node.node_x && drag_surface.mouse-x <= ctx_node.node_x + ctx_node.width && drag_surface.mouse-y >= ctx_node.node_y && drag_surface.mouse-y <= ctx_node.node_y + 38px)
        || (drag_surface.mouse-x >= generate_node.node_x && drag_surface.mouse-x <= generate_node.node_x + generate_node.width && drag_surface.mouse-y >= generate_node.node_y && drag_surface.mouse-y <= generate_node.node_y + 38px)
        || (drag_surface.mouse-x >= sample_node.node_x && drag_surface.mouse-x <= sample_node.node_x + sample_node.width && drag_surface.mouse-y >= sample_node.node_y && drag_surface.mouse-y <= sample_node.node_y + 38px)
        || (drag_surface.mouse-x >= imggen_node.node_x && drag_surface.mouse-x <= imggen_node.node_x + imggen_node.width && drag_surface.mouse-y >= imggen_node.node_y && drag_surface.mouse-y <= imggen_node.node_y + 38px)
        || (drag_surface.mouse-x >= save_node.node_x && drag_surface.mouse-x <= save_node.node_x + save_node.width && drag_surface.mouse-y >= save_node.node_y && drag_surface.mouse-y <= save_node.node_y + 38px)
        || (drag_surface.mouse-x >= detector_node.node_x && drag_surface.mouse-x <= detector_node.node_x + detector_node.width && drag_surface.mouse-y >= detector_node.node_y && drag_surface.mouse-y <= detector_node.node_y + 38px)
        || (drag_surface.mouse-x >= detail_node.node_x && drag_surface.mouse-x <= detail_node.node_x + detail_node.width && drag_surface.mouse-y >= detail_node.node_y && drag_surface.mouse-y <= detail_node.node_y + 38px);
    property <bool> cursor_over_input:
        (drag_surface.mouse-x >= ctx_node.node_x + 16px && drag_surface.mouse-x <= ctx_node.node_x + ctx_node.width - 16px && drag_surface.mouse-y >= ctx_node.node_y + 50px && drag_surface.mouse-y <= ctx_node.node_y + 76px)
        || (drag_surface.mouse-x >= ctx_node.node_x + 16px && drag_surface.mouse-x <= ctx_node.node_x + ctx_node.width - 16px && drag_surface.mouse-y >= ctx_node.node_y + 82px && drag_surface.mouse-y <= ctx_node.node_y + 108px)
        || (drag_surface.mouse-x >= generate_node.node_x + 16px && drag_surface.mouse-x <= generate_node.node_x + generate_node.width - 16px && drag_surface.mouse-y >= generate_node.node_y + 50px && drag_surface.mouse-y <= generate_node.node_y + 76px)
        || (drag_surface.mouse-x >= generate_node.node_x + 16px && drag_surface.mouse-x <= generate_node.node_x + generate_node.width - 16px && drag_surface.mouse-y >= generate_node.node_y + 82px && drag_surface.mouse-y <= generate_node.node_y + 108px)
        || (drag_surface.mouse-x >= sample_node.node_x + 16px && drag_surface.mouse-x <= sample_node.node_x + sample_node.width - 16px && drag_surface.mouse-y >= sample_node.node_y + 50px && drag_surface.mouse-y <= sample_node.node_y + 76px)
        || (drag_surface.mouse-x >= sample_node.node_x + 16px && drag_surface.mouse-x <= sample_node.node_x + sample_node.width - 16px && drag_surface.mouse-y >= sample_node.node_y + 82px && drag_surface.mouse-y <= sample_node.node_y + 108px)
        || (drag_surface.mouse-x >= imggen_node.node_x + 16px && drag_surface.mouse-x <= imggen_node.node_x + imggen_node.width - 16px && drag_surface.mouse-y >= imggen_node.node_y + 50px && drag_surface.mouse-y <= imggen_node.node_y + 76px)
        || (drag_surface.mouse-x >= imggen_node.node_x + 16px && drag_surface.mouse-x <= imggen_node.node_x + imggen_node.width - 16px && drag_surface.mouse-y >= imggen_node.node_y + 82px && drag_surface.mouse-y <= imggen_node.node_y + 108px)
        || (drag_surface.mouse-x >= save_node.node_x + 16px && drag_surface.mouse-x <= save_node.node_x + save_node.width - 16px && drag_surface.mouse-y >= save_node.node_y + 50px && drag_surface.mouse-y <= save_node.node_y + 76px)
        || (drag_surface.mouse-x >= save_node.node_x + 16px && drag_surface.mouse-x <= save_node.node_x + save_node.width - 16px && drag_surface.mouse-y >= save_node.node_y + 82px && drag_surface.mouse-y <= save_node.node_y + 108px);
    background: #171a20;
    GridBackground { width: parent.width; height: parent.height; }
    Text { x: 18px; y: 14px; text: "Workflow / Untitled"; color: #f5f7fa; font-size: 18px; }
    Text { x: 18px; y: 40px; text: "Click a node to edit its parameters"; color: #8f9aaa; font-size: 12px; }
    BezierWire {
        visible: root.ctx_to_generate;
        start_x: ctx_node.out_pin_x;
        start_y: ctx_node.out_pin_y;
        end_x: generate_node.in_pin_2_x;
        end_y: generate_node.in_pin_2_y;
        wire_color: #fb923c;
    }
    BezierWire {
        visible: root.generate_to_detail;
        start_x: generate_node.out_pin_x;
        start_y: generate_node.out_pin_y;
        end_x: detail_node.in_pin_1_x;
        end_y: detail_node.in_pin_1_y;
        wire_color: #65a9ff;
    }
    BezierWire {
        visible: root.imggen_to_generate;
        start_x: imggen_node.out_pin_x;
        start_y: imggen_node.out_pin_y;
        end_x: generate_node.in_pin_1_x;
        end_y: generate_node.in_pin_1_y;
        wire_color: #facc15;
    }
    BezierWire {
        visible: root.sample_to_generate;
        start_x: sample_node.out_pin_x;
        start_y: sample_node.out_pin_y;
        end_x: generate_node.in_pin_3_x;
        end_y: generate_node.in_pin_3_y;
        wire_color: #a78bfa;
    }
    BezierWire {
        visible: true;
        start_x: detector_node.out_pin_x;
        start_y: detector_node.out_pin_y;
        end_x: detail_node.in_pin_2_x;
        end_y: detail_node.in_pin_2_y;
        wire_color: #fb923c;
    }
    BezierWire {
        visible: true;
        start_x: detail_node.out_pin_x;
        start_y: detail_node.out_pin_y;
        end_x: save_node.in_pin_1_x;
        end_y: save_node.in_pin_1_y;
        wire_color: #65a9ff;
    }
    drag_surface := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: root.wire_menu_visible ? default : (root.cursor_over_title ? move : (root.cursor_over_input ? pointer : default));
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.wire_menu_visible = false;
                if event.button == PointerEventButton.right {
                    // The four current wires are routed between these node
                    // bounding boxes. This hit test deliberately includes a
                    // small margin so the thin Bezier stroke is easy to hit.
                    if root.ctx_to_generate && drag_surface.mouse-x >= ctx_node.out_pin_x - 12px && drag_surface.mouse-x <= generate_node.in_pin_2_x + 12px && drag_surface.mouse-y >= (ctx_node.out_pin_y < generate_node.in_pin_2_y ? ctx_node.out_pin_y : generate_node.in_pin_2_y) - 14px && drag_surface.mouse-y <= (ctx_node.out_pin_y > generate_node.in_pin_2_y ? ctx_node.out_pin_y : generate_node.in_pin_2_y) + 14px {
                        root.wire_menu_wire = 0;
                    } else if root.sample_to_generate && drag_surface.mouse-x >= sample_node.out_pin_x - 12px && drag_surface.mouse-x <= generate_node.in_pin_3_x + 12px && drag_surface.mouse-y >= (sample_node.out_pin_y < generate_node.in_pin_3_y ? sample_node.out_pin_y : generate_node.in_pin_3_y) - 14px && drag_surface.mouse-y <= (sample_node.out_pin_y > generate_node.in_pin_3_y ? sample_node.out_pin_y : generate_node.in_pin_3_y) + 14px {
                        root.wire_menu_wire = 2;
                    } else if root.imggen_to_generate && drag_surface.mouse-x >= imggen_node.out_pin_x - 12px && drag_surface.mouse-x <= generate_node.in_pin_1_x + 12px && drag_surface.mouse-y >= (imggen_node.out_pin_y < generate_node.in_pin_1_y ? imggen_node.out_pin_y : generate_node.in_pin_1_y) - 14px && drag_surface.mouse-y <= (imggen_node.out_pin_y > generate_node.in_pin_1_y ? imggen_node.out_pin_y : generate_node.in_pin_1_y) + 14px {
                        root.wire_menu_wire = 3;
                    } else if root.generate_to_detail && drag_surface.mouse-x >= generate_node.out_pin_x - 12px && drag_surface.mouse-x <= detail_node.in_pin_1_x + 12px && drag_surface.mouse-y >= (generate_node.out_pin_y < detail_node.in_pin_1_y ? generate_node.out_pin_y : detail_node.in_pin_1_y) - 14px && drag_surface.mouse-y <= (generate_node.out_pin_y > detail_node.in_pin_1_y ? generate_node.out_pin_y : detail_node.in_pin_1_y) + 14px {
                        root.wire_menu_wire = 1;
                    } else {
                        root.wire_menu_wire = -1;
                    }
                    if root.wire_menu_wire >= 0 {
                        root.wire_menu_x = drag_surface.mouse-x;
                        root.wire_menu_y = drag_surface.mouse-y;
                        root.wire_menu_visible = true;
                    }
                }
                if event.button != PointerEventButton.left { return; }
                root.dragging = false;
                root.pressed_node = -1;
                root.drag_node = -1;
                if drag_surface.mouse-x >= ctx_node.node_x && drag_surface.mouse-x <= ctx_node.node_x + ctx_node.width && drag_surface.mouse-y >= ctx_node.node_y && drag_surface.mouse-y <= ctx_node.node_y + ctx_node.height {
                    root.pressed_node = 0;
                    if drag_surface.mouse-y <= ctx_node.node_y + 38px {
                        root.drag_node = 0;
                        root.dragging = true;
                        root.drag_offset_x = drag_surface.mouse-x - ctx_node.node_x;
                        root.drag_offset_y = drag_surface.mouse-y - ctx_node.node_y;
                    }
                } else if drag_surface.mouse-x >= generate_node.node_x && drag_surface.mouse-x <= generate_node.node_x + generate_node.width && drag_surface.mouse-y >= generate_node.node_y && drag_surface.mouse-y <= generate_node.node_y + generate_node.height {
                    root.pressed_node = 1;
                    if drag_surface.mouse-y <= generate_node.node_y + 38px {
                        root.drag_node = 1;
                        root.dragging = true;
                        root.drag_offset_x = drag_surface.mouse-x - generate_node.node_x;
                        root.drag_offset_y = drag_surface.mouse-y - generate_node.node_y;
                    }
                } else if drag_surface.mouse-x >= sample_node.node_x && drag_surface.mouse-x <= sample_node.node_x + sample_node.width && drag_surface.mouse-y >= sample_node.node_y && drag_surface.mouse-y <= sample_node.node_y + sample_node.height {
                    root.pressed_node = 2;
                    if drag_surface.mouse-y <= sample_node.node_y + 38px {
                        root.drag_node = 2;
                        root.dragging = true;
                        root.drag_offset_x = drag_surface.mouse-x - sample_node.node_x;
                        root.drag_offset_y = drag_surface.mouse-y - sample_node.node_y;
                    }
                } else if drag_surface.mouse-x >= imggen_node.node_x && drag_surface.mouse-x <= imggen_node.node_x + imggen_node.width && drag_surface.mouse-y >= imggen_node.node_y && drag_surface.mouse-y <= imggen_node.node_y + imggen_node.height {
                    root.pressed_node = 3;
                    if drag_surface.mouse-y <= imggen_node.node_y + 38px {
                        root.drag_node = 3;
                        root.dragging = true;
                        root.drag_offset_x = drag_surface.mouse-x - imggen_node.node_x;
                        root.drag_offset_y = drag_surface.mouse-y - imggen_node.node_y;
                    }
                } else if drag_surface.mouse-x >= save_node.node_x && drag_surface.mouse-x <= save_node.node_x + save_node.width && drag_surface.mouse-y >= save_node.node_y && drag_surface.mouse-y <= save_node.node_y + save_node.height {
                    root.pressed_node = 4;
                    if drag_surface.mouse-y <= save_node.node_y + 38px {
                        root.drag_node = 4;
                        root.dragging = true;
                        root.drag_offset_x = drag_surface.mouse-x - save_node.node_x;
                        root.drag_offset_y = drag_surface.mouse-y - save_node.node_y;
                    }
                } else if drag_surface.mouse-x >= detector_node.node_x && drag_surface.mouse-x <= detector_node.node_x + detector_node.width && drag_surface.mouse-y >= detector_node.node_y && drag_surface.mouse-y <= detector_node.node_y + detector_node.height {
                    root.pressed_node = 5;
                    if drag_surface.mouse-y <= detector_node.node_y + 38px {
                        root.drag_node = 5;
                        root.dragging = true;
                        root.drag_offset_x = drag_surface.mouse-x - detector_node.node_x;
                        root.drag_offset_y = drag_surface.mouse-y - detector_node.node_y;
                    }
                } else if drag_surface.mouse-x >= detail_node.node_x && drag_surface.mouse-x <= detail_node.node_x + detail_node.width && drag_surface.mouse-y >= detail_node.node_y && drag_surface.mouse-y <= detail_node.node_y + detail_node.height {
                    root.pressed_node = 6;
                    if drag_surface.mouse-y <= detail_node.node_y + 38px {
                        root.drag_node = 6;
                        root.dragging = true;
                        root.drag_offset_x = drag_surface.mouse-x - detail_node.node_x;
                        root.drag_offset_y = drag_surface.mouse-y - detail_node.node_y;
                    }
                }
            }
            if event.kind == PointerEventKind.up {
                if event.button != PointerEventButton.left { return; }
                if root.pressed_node >= 0 && root.drag_node < 0 {
                    if root.pressed_node == 0 { WorkflowNodes.open_node("ctx-1"); }
                    if root.pressed_node == 1 { WorkflowNodes.open_node("generate-1"); }
                    if root.pressed_node == 2 { WorkflowNodes.open_node("sample-1"); }
                    if root.pressed_node == 3 { WorkflowNodes.open_node("image-gen-1"); }
                    if root.pressed_node == 4 { WorkflowNodes.open_node("save-webp-1"); }
                    if root.pressed_node == 5 { WorkflowNodes.open_node("detector-1"); }
                    if root.pressed_node == 6 { WorkflowNodes.open_node("detail-1"); }
                }
                root.dragging = false;
                root.drag_node = -1;
                root.pressed_node = -1;
            }
        }
        moved => {
            if drag_surface.pressed && root.drag_node >= 0 {
                if root.drag_node == 0 { ctx_node.node_x = drag_surface.mouse-x - root.drag_offset_x; ctx_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 1 { generate_node.node_x = drag_surface.mouse-x - root.drag_offset_x; generate_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 2 { sample_node.node_x = drag_surface.mouse-x - root.drag_offset_x; sample_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 3 { imggen_node.node_x = drag_surface.mouse-x - root.drag_offset_x; imggen_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 4 { save_node.node_x = drag_surface.mouse-x - root.drag_offset_x; save_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 5 { detector_node.node_x = drag_surface.mouse-x - root.drag_offset_x; detector_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 6 { detail_node.node_x = drag_surface.mouse-x - root.drag_offset_x; detail_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
            }
        }
    }
    ctx_node := LoadModelNode {}
    generate_node := GenerateImageNode {}
    sample_node := SamplerSchedulerNode {}
    imggen_node := PromptNode {}
    save_node := SaveImageNode {}
    detector_node := LoadDetectorNode {}
    detail_node := DetailImageNode {}
    wire_surface := TouchArea {
        visible: root.wire_dragging;
        width: parent.width;
        height: parent.height;
        mouse-cursor: root.wire_menu_visible ? default : crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up {
                if event.button != PointerEventButton.left { return; }
                if root.wire_source == 0 { root.ctx_to_generate = false; }
                if root.wire_source == 1 { root.generate_to_detail = false; }
                if root.wire_source == 2 { root.sample_to_generate = false; }
                if root.wire_source == 3 { root.imggen_to_generate = false; }
                if root.wire_source == 0 && wire_surface.mouse-x >= generate_node.node_x - 16px && wire_surface.mouse-x <= generate_node.node_x + 16px && wire_surface.mouse-y >= generate_node.node_y + 66px && wire_surface.mouse-y <= generate_node.node_y + 106px {
                    root.ctx_to_generate = true;
                }
                if root.wire_source == 1 && wire_surface.mouse-x >= detail_node.node_x - 16px && wire_surface.mouse-x <= detail_node.node_x + 16px && wire_surface.mouse-y >= detail_node.node_y + 38px && wire_surface.mouse-y <= detail_node.node_y + 78px {
                    root.generate_to_detail = true;
                }
                if root.wire_source == 2 && wire_surface.mouse-x >= generate_node.node_x - 16px && wire_surface.mouse-x <= generate_node.node_x + 16px && wire_surface.mouse-y >= generate_node.node_y + 94px && wire_surface.mouse-y <= generate_node.node_y + 134px {
                    root.sample_to_generate = true;
                }
                if root.wire_source == 3 && wire_surface.mouse-x >= generate_node.node_x - 16px && wire_surface.mouse-x <= generate_node.node_x + 16px && wire_surface.mouse-y >= generate_node.node_y + 38px && wire_surface.mouse-y <= generate_node.node_y + 78px {
                    root.imggen_to_generate = true;
                }
                root.wire_dragging = false;
                root.wire_source = -1;
            }
        }
        moved => {
            if root.wire_dragging {
                root.wire_end_x = wire_surface.mouse-x;
                root.wire_end_y = wire_surface.mouse-y;
            }
        }
    }
    ctx_output_pin := TouchArea {
        x: ctx_node.node_x + 210px; y: ctx_node.node_y + 66px; width: 28px; height: 40px;
        mouse-cursor: root.wire_menu_visible ? default : crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.wire_menu_visible = false;
                root.ctx_to_generate = false;
                root.wire_dragging = true; root.wire_source = 0;
                root.wire_start_x = ctx_node.out_pin_x; root.wire_start_y = ctx_node.out_pin_y;
                root.wire_end_x = ctx_node.out_pin_x; root.wire_end_y = ctx_node.out_pin_y;
            }
        }
        moved => {
            if root.wire_dragging {
                root.wire_end_x = ctx_node.node_x + 210px + ctx_output_pin.mouse-x;
                root.wire_end_y = ctx_node.node_y + 66px + ctx_output_pin.mouse-y;
            }
        }
    }
    generate_output_pin := TouchArea {
        x: generate_node.node_x + 210px; y: generate_node.node_y + 66px; width: 28px; height: 40px;
        mouse-cursor: root.wire_menu_visible ? default : crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.wire_menu_visible = false;
                root.generate_to_detail = false;
                root.wire_dragging = true; root.wire_source = 1;
                root.wire_start_x = generate_node.out_pin_x; root.wire_start_y = generate_node.out_pin_y;
                root.wire_end_x = generate_node.out_pin_x; root.wire_end_y = generate_node.out_pin_y;
            }
        }
        moved => {
            if root.wire_dragging {
                root.wire_end_x = generate_node.node_x + 210px + generate_output_pin.mouse-x;
                root.wire_end_y = generate_node.node_y + 66px + generate_output_pin.mouse-y;
            }
        }
    }
    sample_output_pin := TouchArea {
        x: sample_node.node_x + 210px; y: sample_node.node_y + 66px; width: 28px; height: 40px;
        mouse-cursor: root.wire_menu_visible ? default : crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.wire_menu_visible = false;
                root.sample_to_generate = false;
                root.wire_dragging = true; root.wire_source = 2;
                root.wire_start_x = sample_node.out_pin_x; root.wire_start_y = sample_node.out_pin_y;
                root.wire_end_x = sample_node.out_pin_x; root.wire_end_y = sample_node.out_pin_y;
            }
        }
        moved => {
            if root.wire_dragging {
                root.wire_end_x = sample_node.node_x + 210px + sample_output_pin.mouse-x;
                root.wire_end_y = sample_node.node_y + 66px + sample_output_pin.mouse-y;
            }
        }
    }
    imggen_output_pin := TouchArea {
        x: imggen_node.node_x + 210px; y: imggen_node.node_y + 66px; width: 28px; height: 40px;
        mouse-cursor: root.wire_menu_visible ? default : crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.wire_menu_visible = false;
                root.imggen_to_generate = false;
                root.wire_dragging = true; root.wire_source = 3;
                root.wire_start_x = imggen_node.out_pin_x; root.wire_start_y = imggen_node.out_pin_y;
                root.wire_end_x = imggen_node.out_pin_x; root.wire_end_y = imggen_node.out_pin_y;
            }
        }
        moved => {
            if root.wire_dragging {
                root.wire_end_x = imggen_node.node_x + 210px + imggen_output_pin.mouse-x;
                root.wire_end_y = imggen_node.node_y + 66px + imggen_output_pin.mouse-y;
            }
        }
    }
    BezierWire {
        visible: root.wire_dragging;
        start_x: root.wire_start_x;
        start_y: root.wire_start_y;
        end_x: root.wire_end_x;
        end_y: root.wire_end_y;
        wire_color: #f5f7fa;
    }
    Rectangle {
        visible: root.wire_menu_visible;
        x: root.wire_menu_x; y: root.wire_menu_y;
        width: 150px; height: 42px;
        background: #252a34; border-width: 1px; border-color: #667085; border-radius: 5px;
        Text { x: 12px; y: 12px; text: "Disconnect wire"; color: #f5f7fa; font-size: 13px; }
        TouchArea {
            mouse-cursor: default;
            clicked => {
                if root.wire_menu_wire == 0 { root.ctx_to_generate = false; }
                if root.wire_menu_wire == 1 { root.generate_to_detail = false; }
                if root.wire_menu_wire == 2 { root.sample_to_generate = false; }
                if root.wire_menu_wire == 3 { root.imggen_to_generate = false; }
                root.wire_menu_visible = false;
                root.wire_menu_wire = -1;
            }
        }
    }
    Button {
        x: parent.width - self.width - 24px;
        y: 18px;
        text: "Back to Home";
        clicked => { AppRouter.navigate("Home"); }
    }
    Button {
        x: parent.width - self.width - 150px;
        y: 18px;
        text: "Save Workflow";
        clicked => { AppRouter.save_workflow(); }
    }
    Button {
        x: parent.width - self.width - 270px;
        y: 18px;
        text: "Run";
        clicked => { AppRouter.run_workflow(); }
    }
}

// --- router_view.slint ---
component RouterView inherits Rectangle {
    in-out property <string> current_page <=> AppRouter.current_page;
    in-out property <[string]> models <=> models_page.models;

    if root.current_page == "Home": HomePage { width: 100%; height: 100%; }
    if root.current_page == "Workflow": WorkflowPage { width: 100%; height: 100%; }
    models_page := ModelsPage { visible: root.current_page == "Models"; width: 100%; height: 100%; }
    if root.current_page == "Settings": SettingsPage { width: 100%; height: 100%; }
    if root.current_page == "NodePrompt": PromptNodePage { width: 100%; height: 100%; }
    if root.current_page == "NodeDiffusion": DiffusionNodePage { width: 100%; height: 100%; }
    if root.current_page == "NodePreview": PreviewNodePage { width: 100%; height: 100%; }
    if root.current_page == "NodeContextParams": ContextParamsNodePage { width: 100%; height: 100%; }
    if root.current_page == "NodeSampleParams": SampleParamsNodePage { width: 100%; height: 100%; }
    if root.current_page == "NodeImageGenParams": ImageGenParamsNodePage { width: 100%; height: 100%; }
    if root.current_page == "NodeLoadDetector": LoadDetectorNodePage { width: 100%; height: 100%; }
    if root.current_page == "NodeDetailImage": DetailImageNodePage { width: 100%; height: 100%; }
    if root.current_page == "NodeGenerateImage": GenerateImageNodePage { width: 100%; height: 100%; }
    if root.current_page == "NodeSaveWebP": SaveWebPNodePage { width: 100%; height: 100%; }
}

// --- app_window.slint ---
export component AppWindow inherits Window {
    preferred-width: 1440px;
    preferred-height: 880px;
    min-width: 720px;
    min-height: 440px;
    title: "Renga AI";

    in-out property <string> current_page <=> AppRouter.current_page;
    in-out property <[string]> models <=> router.models;
    router := RouterView { width: 100%; height: 100%; }
}
