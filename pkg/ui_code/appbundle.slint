    in-out property <string> backend: "diffusion=cuda0,detector=cuda0";
    in-out property <string> threads: "Auto";
    in-out property <string> wtype: "FP16";
    in-out property <string> flash_attn: "false";
    in-out property <string> auto_fit: "false";
    in-out property <string> max_vram: "Automatic";
    in-out property <string> sample_method: "Euler";
    in-out property <string> scheduler: "Karras";
    in-out property <string> sample_steps: "20";
    in-out property <string> cfg: "6.0";
    in-out property <string> eta: "0.0";
    in-out property <string> flow_shift: "1.0";
    in-out property <string> custom_sigmas: "Default";
    in-out property <string> prompt: "masterpiece, best quality, highres, detailed background";
    in-out property <string> negative_prompt: "blurry, low quality";
    in-out property <string> prompt2: "masterpiece, best quality, highres, detailed background";
