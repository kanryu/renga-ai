    Rectangle { x: 28px; y: 262px; width: 664px; height: 34px; background: #303744; border-radius: 4px;
        Text { x: 12px; y: 8px; text: root.api_signature; color: #cbd3df; font-size: 12px; }
    }
    Text { x: 28px; y: 320px; text: "Pins accept and produce typed workflow values."; color: #9aa5b5; font-size: 13px; }
}

