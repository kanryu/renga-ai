import { Button, LineEdit, ListView, TextEdit, VerticalBox } from "std-widgets.slint";

// --- renga/router.slint ---
export global AppRouter {
    in-out property <string> current_page: "Workflow";
    in-out property <length> ctx_node_x: 40px;
    in-out property <length> ctx_node_y: 120px;
    in-out property <length> generate_node_x: 500px;
    in-out property <length> generate_node_y: 120px;
    in-out property <length> sample_node_x: 50px;
    in-out property <length> sample_node_y: 480px;
    in-out property <length> imggen_node_x: 320px;
    in-out property <length> imggen_node_y: 390px;
    in-out property <length> save_node_x: 920px;
    in-out property <length> save_node_y: 125px;
    in-out property <length> detector_node_x: 40px;
    in-out property <length> detector_node_y: 650px;
    in-out property <length> detail_node_x: 760px;
    in-out property <length> detail_node_y: 650px;
    in-out property <length> ctx_node_width: 230px;
    in-out property <length> ctx_node_height: 162px;
    in-out property <length> sample_node_width: 230px;
    in-out property <length> sample_node_height: 162px;
    in-out property <length> imggen_node_width: 230px;
    in-out property <length> imggen_node_height: 220px;
    in-out property <length> generate_node_width: 230px;
    in-out property <length> generate_node_height: 162px;
    in-out property <length> save_node_width: 230px;
    in-out property <length> save_node_height: 154px;
    in-out property <length> detector_node_width: 230px;
    in-out property <length> detector_node_height: 162px;
    in-out property <length> detail_node_width: 230px;
    in-out property <length> detail_node_height: 360px;
    in-out property <string> checkpoint_path: "Illustrious-XL-v2.0.safetensors";
    in-out property <string> diffusion_model_path: "sdxl-unet.safetensors";
    in-out property <string> external_vae_path: "Optional / embedded";
    in-out property <string> vae_path: "sdxl-vae.safetensors";
    in-out property <string> clip_l_path: "clip_l.safetensors";
    in-out property <string> t5xxl_path: "t5xxl_fp16.safetensors";
    in-out property <string> separated_models: "false";
    in-out property <string> backend: "diffusion=cuda0,detector=cuda0";
    in-out property <string> threads: "Auto";
    in-out property <string> wtype: "FP16";
    in-out property <string> flash_attn: "false";
    in-out property <string> max_vram: "Automatic";
    in-out property <string> sample_method: "Euler";
    in-out property <string> scheduler: "Karras";
    in-out property <string> sample_steps: "20";
    in-out property <string> eta: "0.0";
    in-out property <string> flow_shift: "1.0";
    in-out property <string> custom_sigmas: "Default";
    in-out property <string> prompt: "masterpiece, best quality, highres, detailed background";
    in-out property <string> negative_prompt: "blurry, low quality";
    in-out property <string> width: "1024";
    in-out property <string> height: "1344";
    in-out property <string> batch_count: "1";
    in-out property <string> seed: "Random";
    in-out property <string> loras: "None";
    in-out property <string> hires_cache: "Default";
    in-out property <string> detector_model_path: "face_yolov8m-face.safetensors";
    in-out property <string> detector_extra_args: "confidence=0.05,mask_blur=4,inpaint_padding=32";
    in-out property <string> detail_prompt: "detailed face, detailed eyes, beautiful eyes, sharp facial features, high quality";
    in-out property <string> detail_negative_prompt: "blurry face, deformed face, bad eyes, low quality";
    in-out property <string> inpaint_width: "512";
    in-out property <string> inpaint_height: "512";
    in-out property <string> inpaint_strength: "0.4";
    callback navigate(string);
    callback open_file(string);
    callback save_workflow();
    callback run_workflow();
    navigate(route) => { current_page = route; }
}

export global WorkflowNodes {
    in-out property <[string]> node_ids: [];
    in-out property <[string]> node_types: [];
    in-out property <string> selected_id: "";
    in-out property <bool> ctx_to_generate: true;
    in-out property <bool> sample_to_generate: true;
    in-out property <bool> imggen_to_generate: true;
    in-out property <bool> generate_to_detail: true;
    callback open_node(string);
    callback cancel_edit();
}

// --- views/home_page.slint ---
component HomePage inherits Rectangle {

    VerticalBox {
        alignment: center;
        spacing: 12px;
        Text { text: "Renga AI"; font-size: 28px; horizontal-alignment: center; }
        Text { text: "Multimodal AI Workflow Studio"; horizontal-alignment: center; }
        Button { text: "Open Workflow"; clicked => { AppRouter.navigate("Workflow"); } }
        Button { text: "Model Library"; clicked => { AppRouter.navigate("Models"); } }
        Button { text: "Settings"; clicked => { AppRouter.navigate("Settings"); } }
    }
}

// --- views/models_page.slint ---
component ModelsPage inherits VerticalBox {
    in-out property <[string]> models: [];
    alignment: center;
    spacing: 12px;
    Text {
        text: "Model Library";
        font-size: 24px;
        horizontal-alignment: center;
    }
    ListView {
        for model_name in root.models: Text {
            text: model_name;
            horizontal-alignment: center;
        }
    }
    Button {
        text: "Back to Home";
        clicked => { AppRouter.navigate("Home"); }
    }
}

// --- views/node_windows/node_panel.slint ---
export component NodePanel inherits Rectangle {
    in property <string> node_title;
    in property <string> node_kind;
    in property <string> summary_line_1: "";
    in property <string> summary_line_2: "";
    in property <string> summary_line_3: "";
    in property <string> summary_line_4: "";
    in property <string> summary_line_5: "";
    in property <string> summary_line_6: "";
    in property <string> summary_label_1: "";
    in property <string> summary_label_2: "";
    in property <string> summary_label_3: "";
    in property <string> summary_label_4: "";
    in property <string> summary_label_5: "";
    in property <string> summary_label_6: "";
    in property <bool> show_line_labels: false;
    in property <length> summary_line_1_height: 26px;
    in property <length> summary_line_2_height: 26px;
    in property <length> summary_line_3_height: 26px;
    in property <length> summary_line_4_height: 26px;
    in property <length> summary_line_5_height: 26px;
    in property <length> summary_line_6_height: 26px;
    in property <int> body_line_count: 3;
    in property <int> input_count: 1;
    in property <color> input_1_color: root.accent_color;
    in property <color> input_2_color: root.accent_color;
    in property <color> input_3_color: root.accent_color;
    in property <string> input_1_label: "";
    in property <string> input_2_label: "";
    in property <string> input_3_label: "";
    in property <color> accent_color;
    in property <color> output_pin_color: root.accent_color;
    in property <string> output_pin_label: "";
    in property <bool> show_output_pin: true;
    in-out property <length> node_x: 0px;
    in-out property <length> node_y: 0px;
    in-out property <length> node_width: 230px;
    in-out property <length> node_height: 154px;
    callback open;
    out property <length> in_pin_1_x: root.node_x;
    out property <length> pin_center_y: root.input_count >= 2 ? root.node_height / 2 + 9px : root.node_height / 2;
    out property <length> in_pin_1_y: root.node_y + (root.input_count >= 2 ? root.pin_center_y - 28px : root.pin_center_y);
    out property <length> in_pin_2_x: root.node_x;
    out property <length> in_pin_2_y: root.node_y + root.pin_center_y;
    out property <length> in_pin_3_x: root.node_x;
    out property <length> in_pin_3_y: root.node_y + root.pin_center_y + 28px;
    out property <length> out_pin_x: root.node_x + root.width;
    out property <length> out_pin_y: root.node_y + root.pin_center_y;
    property <length> row_1_y: root.show_line_labels ? 64px : 50px;
    property <length> row_2_y: root.show_line_labels ? root.row_1_y + root.summary_line_1_height + 20px : 82px;
    property <length> row_3_y: root.show_line_labels ? root.row_2_y + root.summary_line_2_height + (root.summary_label_3 != "" ? 20px : 8px) : 114px;
    property <length> row_4_y: root.show_line_labels ? root.row_3_y + root.summary_line_3_height + (root.summary_label_4 != "" ? 20px : 8px) : 146px;
    property <length> row_5_y: root.show_line_labels ? root.row_4_y + root.summary_line_4_height + (root.summary_label_5 != "" ? 20px : 8px) : 178px;
    property <length> row_6_y: root.show_line_labels ? root.row_5_y + root.summary_line_5_height + (root.summary_label_6 != "" ? 20px : 8px) : 210px;
    x: root.node_x; y: root.node_y; width: root.node_width; height: root.node_height;
    background: #202024; border-width: 1px; border-color: #3f3f46; border-radius: 8px;
    Rectangle { x: 0px; y: 0px; width: 100%; height: 38px; background: root.accent_color; border-radius: 8px; Text { x: 14px; y: 9px; text: root.node_title; color: #ffffff; font-size: 15px; font-weight: 700; } }
    Text { x: 16px; y: root.row_1_y - 18px; text: root.summary_label_1; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_1 != ""; }
    Text { x: 16px; y: root.row_2_y - 18px; text: root.summary_label_2; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_2 != ""; }
    Text { x: 16px; y: root.row_3_y - 18px; text: root.summary_label_3; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_3 != ""; }
    Text { x: 16px; y: root.row_4_y - 18px; text: root.summary_label_4; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_4 != ""; }
    Text { x: 16px; y: root.row_5_y - 18px; text: root.summary_label_5; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_5 != ""; }
    Text { x: 16px; y: root.row_6_y - 18px; text: root.summary_label_6; color: #a1a1aa; font-size: 11px; visible: root.show_line_labels && root.summary_label_6 != ""; }
    Rectangle { x: 16px; y: root.row_1_y; width: parent.width - 32px; height: root.summary_line_1_height; background: #121214; border-radius: 4px; clip: true; Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_1; color: #e4e4e7; font-size: 12px; wrap: word-wrap; } }
    Rectangle { x: 16px; y: root.row_2_y; width: parent.width - 32px; height: root.summary_line_2_height; background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 2 && root.summary_line_2 != ""; Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_2; color: #e4e4e7; font-size: 12px; wrap: word-wrap; } }
    Rectangle { x: 16px; y: root.row_3_y; width: parent.width - 32px; height: root.summary_line_3_height; background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 3 && root.summary_line_3 != ""; Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_3; color: #e4e4e7; font-size: 12px; wrap: word-wrap; } }
    Rectangle { x: 16px; y: root.row_4_y; width: parent.width - 32px; height: root.summary_line_4_height; background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 4 && root.summary_line_4 != ""; Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_4; color: #e4e4e7; font-size: 12px; wrap: word-wrap; } }
    Rectangle { x: 16px; y: root.row_5_y; width: parent.width - 32px; height: root.summary_line_5_height; background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 5 && root.summary_line_5 != ""; Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_5; color: #e4e4e7; font-size: 12px; wrap: word-wrap; } }
    Rectangle { x: 16px; y: root.row_6_y; width: parent.width - 32px; height: root.summary_line_6_height; background: #121214; border-radius: 4px; clip: true; visible: root.body_line_count >= 6 && root.summary_line_6 != ""; Text { x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px; text: root.summary_line_6; color: #e4e4e7; font-size: 12px; wrap: word-wrap; } }
    if root.input_count >= 1: Rectangle { x: -7px; y: root.in_pin_1_y - root.node_y - 7px; width: 14px; height: 14px; border-radius: 7px; background: root.input_1_color; }
    if root.input_count >= 2: Rectangle { x: -7px; y: root.in_pin_2_y - root.node_y - 7px; width: 14px; height: 14px; border-radius: 7px; background: root.input_2_color; }
    if root.input_count >= 3: Rectangle { x: -7px; y: root.in_pin_3_y - root.node_y - 7px; width: 14px; height: 14px; border-radius: 7px; background: root.input_3_color; }
    if root.show_output_pin: Rectangle { x: root.node_width - 7px; y: root.out_pin_y - root.node_y - 7px; width: 14px; height: 14px; border-radius: 7px; background: root.output_pin_color; }
    Text { x: -112px; y: root.in_pin_1_y - root.node_y - 8px; width: 98px; text: root.input_1_label; color: root.input_1_color; font-size: 11px; horizontal-alignment: right; visible: root.input_1_label != ""; }
    Text { x: -112px; y: root.in_pin_2_y - root.node_y - 8px; width: 98px; text: root.input_2_label; color: root.input_2_color; font-size: 11px; horizontal-alignment: right; visible: root.input_2_label != ""; }
    Text { x: -112px; y: root.in_pin_3_y - root.node_y - 8px; width: 98px; text: root.input_3_label; color: root.input_3_color; font-size: 11px; horizontal-alignment: right; visible: root.input_3_label != ""; }
    Text { x: root.node_width + 14px; y: root.out_pin_y - root.node_y - 8px; width: 90px; text: root.output_pin_label; color: root.output_pin_color; font-size: 11px; visible: root.show_output_pin && root.output_pin_label != ""; }
}

// --- views/node_windows/workflow_nodes.slint ---
export component LoadModelNode inherits NodePanel {
    node_x <=> AppRouter.ctx_node_x; node_y <=> AppRouter.ctx_node_y;
    node_width <=> AppRouter.ctx_node_width; node_height <=> AppRouter.ctx_node_height;
    node_title: "Load Model"; node_kind: "Struct input";
    summary_line_1: "model: " + AppRouter.checkpoint_path;
    summary_line_2: "threads: " + AppRouter.threads + " / " + AppRouter.wtype;
    summary_line_3: "Model context parameters"; input_count: 0;
    output_pin_label: "Model"; accent_color: #fb923c;
}

export component GenerateImageNode inherits NodePanel {
    node_x <=> AppRouter.generate_node_x; node_y <=> AppRouter.generate_node_y;
    node_width <=> AppRouter.generate_node_width; node_height <=> AppRouter.generate_node_height;
    node_title: "Generate Image"; node_kind: "Image generation";
    summary_line_1: "rendering: SDCTX + SDIMG";
    summary_line_2: "size: " + AppRouter.width + " x " + AppRouter.height;
    summary_line_3: "batch count: " + AppRouter.batch_count; input_count: 3;
    input_1_label: "Prompt"; input_2_label: "Model"; input_3_label: "Sampler";
    input_1_color: #facc15; input_2_color: #fb923c; input_3_color: #a78bfa;
    output_pin_label: "Image"; output_pin_color: #65a9ff; accent_color: #65a9ff;
}

export component SamplerSchedulerNode inherits NodePanel {
    node_x <=> AppRouter.sample_node_x; node_y <=> AppRouter.sample_node_y;
    node_width <=> AppRouter.sample_node_width; node_height <=> AppRouter.sample_node_height;
    node_title: "Sampler & Scheduler"; node_kind: "Struct input";
    summary_line_1: "method: " + AppRouter.sample_method;
    summary_line_2: "steps: " + AppRouter.sample_steps + " / scheduler: " + AppRouter.scheduler;
    summary_line_3: "Sampler parameters"; input_count: 0;
    output_pin_label: "Sampler"; accent_color: #a78bfa;
}

export component PromptNode inherits NodePanel {
    node_x <=> AppRouter.imggen_node_x; node_y <=> AppRouter.imggen_node_y;
    node_width <=> AppRouter.imggen_node_width; node_height <=> AppRouter.imggen_node_height;
    node_title: "Prompt"; node_kind: "Text prompt";
    summary_line_1: AppRouter.prompt; summary_line_2: AppRouter.negative_prompt;
    summary_label_1: "Positive Prompt"; summary_label_2: "Negative Prompt";
    summary_line_1_height: 64px; summary_line_2_height: 64px;
    show_line_labels: true; body_line_count: 2; input_count: 0;
    output_pin_label: "Prompt"; output_pin_color: #facc15; accent_color: #facc15;
}

export component SaveImageNode inherits NodePanel {
    node_x <=> AppRouter.save_node_x; node_y <=> AppRouter.save_node_y;
    node_width <=> AppRouter.save_node_width; node_height <=> AppRouter.save_node_height;
    node_title: "Save Image"; node_kind: "Image output";
    summary_line_1: "image: generated output"; summary_line_2: "format: WebP";
    body_line_count: 2; input_1_label: "Image"; show_output_pin: false;
    input_1_color: #65a9ff; accent_color: #65a9ff;
}

export component LoadDetectorNode inherits NodePanel {
    node_x <=> AppRouter.detector_node_x; node_y <=> AppRouter.detector_node_y;
    node_width <=> AppRouter.detector_node_width; node_height <=> AppRouter.detector_node_height;
    node_title: "Load Detector"; node_kind: "ADetailer detector";
    summary_line_1: AppRouter.detector_model_path;
    summary_line_2: "backend: " + AppRouter.backend;
    summary_line_3: "Face detection model"; input_count: 0;
    output_pin_label: "Detector"; output_pin_color: #fb923c; accent_color: #fb923c;
}

export component DetailImageNode inherits NodePanel {
    node_x <=> AppRouter.detail_node_x; node_y <=> AppRouter.detail_node_y;
    node_width <=> AppRouter.detail_node_width; node_height <=> AppRouter.detail_node_height;
    node_title: "Detail Image"; node_kind: "E-Detailer processing";
    summary_line_1: AppRouter.detail_prompt; summary_line_2: AppRouter.detail_negative_prompt;
    summary_line_3: "inpaint: " + AppRouter.inpaint_width + " x " + AppRouter.inpaint_height;
    summary_line_4: "strength: " + AppRouter.inpaint_strength + " / confidence=0.05";
    summary_line_5: "mask_blur=4 / inpaint_padding=32"; summary_line_6: AppRouter.detector_extra_args;
    summary_label_1: "Positive Prompt"; summary_label_2: "Negative Prompt";
    summary_line_1_height: 64px; summary_line_2_height: 64px;
    show_line_labels: true; body_line_count: 6; input_count: 2;
    input_1_label: "Image"; input_2_label: "Detector";
    input_1_color: #65a9ff; input_2_color: #fb923c;
    output_pin_label: "Image"; output_pin_color: #65a9ff; accent_color: #65a9ff;
}

// --- views/node_pages.slint ---
component NodePage inherits Rectangle {
    in property <string> node_title;
    in property <string> node_kind;
    in property <string> node_description;
    background: #20242c;
    Rectangle {
        x: 0px; y: 0px; width: 100%; height: 64px; background: #2a303b;
        Text { x: 24px; y: 18px; text: root.node_title; color: #f5f7fa; font-size: 22px; }
        Text { x: 24px; y: 43px; text: root.node_kind; color: #aeb7c6; font-size: 11px; }
    }
    Rectangle {
        x: 672px; y: 14px; width: 34px; height: 34px;
        border-radius: 17px; background: #454d5b;
        Text { text: "×"; color: #ffffff; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { AppRouter.navigate("Workflow"); } }
    }
    Button {
        x: 540px; y: 14px; width: 118px; height: 34px;
        text: "Cancel";
        clicked => { WorkflowNodes.cancel_edit(); }
    }
    Text { x: 28px; y: 104px; text: root.node_description; color: #d7dce5; font-size: 15px; }
    Rectangle { x: 28px; y: 142px; width: 664px; height: 1px; background: #414957; }
    Text { x: 28px; y: 166px; text: "Node parameters"; color: #f5f7fa; font-size: 16px; }
    Text { x: 28px; y: 198px; text: "This editor will be extended with node-specific controls."; color: #9aa5b5; font-size: 13px; }
}

export component PromptNodePage inherits NodePage {
    node_title: "Prompt Node"; node_kind: "Text input node";
    node_description: "Create and refine the text prompt for the next node.";
}

export component DiffusionNodePage inherits NodePage {
    node_title: "Stable Diffusion Node"; node_kind: "Image generation node";
    node_description: "Configure the image generation model and sampling options.";
}

export component PreviewNodePage inherits NodePage {
    node_title: "Image Preview Node"; node_kind: "Output node";
    node_description: "Inspect the generated image and pass it to another node.";
}

component ParameterRow inherits Rectangle {
    in property <string> parameter_name;
    in property <string> parameter_value;
    width: 320px;
    height: 28px;
    Text { x: 0px; y: 6px; text: root.parameter_name; color: #cbd3df; font-size: 13px; }
    Rectangle { x: 170px; y: 0px; width: 150px; height: 28px; background: #303744; border-radius: 4px;
        Text { x: 8px; y: 6px; text: root.parameter_value; color: #f5f7fa; font-size: 12px; }
    }
}

component EditorField inherits Rectangle {
    in-out property <string> value;
    in property <string> placeholder: "";
    in property <length> field_width: 300px;
    in property <color> field_background: #303744;
    width: root.field_width;
    height: 32px;
    background: root.field_background;
    border-width: 1px;
    border-color: #465264;
    border-radius: 4px;
    LineEdit {
        x: 10px;
        y: 4px;
        width: parent.width - 20px;
        height: parent.height - 8px;
        text <=> root.value;
        font-size: 13px;
    }
}

component MultilineEditor inherits Rectangle {
    in-out property <string> value;
    in property <length> field_width: 470px;
    in property <length> field_height: 92px;
    width: root.field_width;
    height: root.field_height;
    background: #303744;
    border-width: 1px;
    border-color: #465264;
    border-radius: 4px;
    TextEdit {
        x: 8px;
        y: 6px;
        width: parent.width - 16px;
        height: parent.height - 12px;
        text <=> root.value;
        wrap: word-wrap;
        font-size: 13px;
        placeholder-text: "Enter prompt...";
    }
}

component EditorLabel inherits Rectangle {
    in property <string> label;
    width: 150px;
    height: 32px;
    Text { x: 0px; y: 8px; text: root.label; color: #cbd3df; font-size: 13px; }
}

component FilePickerField inherits Rectangle {
