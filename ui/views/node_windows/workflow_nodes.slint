import { AppRouter } from "../../renga/router.slint";
import { NodePanel } from "./node_panel.slint";

export component LoadModelNode inherits NodePanel {
    node_title: "Load Model"; node_kind: "Struct input";
    summary_line_1: AppRouter.separated_models == "true" ? "diffusion: " + AppRouter.diffusion_model_path : "model: " + AppRouter.checkpoint_path;
    summary_line_2: AppRouter.separated_models == "true" ? "vae: " + AppRouter.vae_path + " / text: " + AppRouter.text_encoder_path : "threads: " + AppRouter.threads + " / " + AppRouter.wtype;
    summary_line_3: "Model context parameters"; input_count: 0;
    output_pin_label: "Model"; output_pin_type: "Model"; accent_color: #fb923c;
}

export component GenerateImageNode inherits NodePanel {
    node_title: "Generate Image"; node_kind: "Image generation";
    summary_line_1: "rendering: SDCTX + SDIMG";
    summary_line_2: "size: " + AppRouter.width + " x " + AppRouter.height;
    summary_line_3: "batch count: " + AppRouter.batch_count; input_count: 3;
    input_1_label: "Prompt"; input_2_label: "Sampler"; input_3_label: "Model";
    input_1_type: "Prompt"; input_2_type: "Sampler"; input_3_type: "Model";
    input_1_color: #facc15; input_2_color: #a78bfa; input_3_color: #fb923c;
    output_pin_label: "Image"; output_pin_type: "Image"; output_pin_color: #65a9ff; accent_color: #65a9ff;
}

export component SamplerSchedulerNode inherits NodePanel {
    node_title: "Sampler & Scheduler"; node_kind: "Struct input";
    summary_line_1: "method: " + AppRouter.sample_method;
    summary_line_2: "steps: " + AppRouter.sample_steps + " / scheduler: " + AppRouter.scheduler + " / CFG: " + AppRouter.cfg;
    summary_line_3: "Sampler parameters"; input_count: 0;
    output_pin_label: "Sampler"; output_pin_type: "Sampler"; accent_color: #a78bfa;
}

export component PromptNode inherits NodePanel {
    node_title: "Prompt"; node_kind: "Text prompt";
    summary_line_1: root.node_id == "image-gen-2" ? AppRouter.prompt2 : AppRouter.prompt;
    summary_line_2: root.node_id == "image-gen-2" ? AppRouter.negative_prompt2 : AppRouter.negative_prompt;
    summary_label_1: "Positive Prompt"; summary_label_2: "Negative Prompt";
    summary_line_1_height: 64px; summary_line_2_height: 64px;
    show_line_labels: true; body_line_count: 2; input_count: 0;
    output_pin_label: "Prompt"; output_pin_type: "Prompt"; output_pin_color: #facc15; accent_color: #facc15;
}

export component SaveImageNode inherits NodePanel {
    node_title: "Save Image"; node_kind: "Image output";
    summary_line_1: "Generated images will be here";
    summary_line_1_height: 220px; body_line_count: 1;
    show_image_preview: true; preview_images: root.node_id == "save-webp-2" ? AppRouter.output_images2 : AppRouter.output_images;
    input_1_label: "Image"; input_1_type: "Image"; show_output_pin: false;
    input_1_color: #65a9ff; accent_color: #65a9ff;
}

export component LoadDetectorNode inherits NodePanel {
    node_title: "Load Detector"; node_kind: "ADetailer detector";
    summary_line_1: AppRouter.detector_model_path;
    summary_line_2: "backend: " + AppRouter.backend;
    summary_line_3: "Face detection model"; input_count: 0;
    output_pin_label: "Detector"; output_pin_type: "Detector"; output_pin_color: #fb923c; accent_color: #fb923c;
}

export component DetailImageNode inherits NodePanel {
    node_title: "Detail Image"; node_kind: "E-Detailer processing";
    summary_line_1: root.node_id == "detail-2" ? AppRouter.detail_prompt2 : AppRouter.detail_prompt;
    summary_line_2: root.node_id == "detail-2" ? AppRouter.detail_negative_prompt2 : AppRouter.detail_negative_prompt;
    summary_line_3: "inpaint: " + (root.node_id == "detail-2" ? AppRouter.inpaint_width2 : AppRouter.inpaint_width) + " x " + (root.node_id == "detail-2" ? AppRouter.inpaint_height2 : AppRouter.inpaint_height);
    summary_line_4: "strength: " + (root.node_id == "detail-2" ? AppRouter.inpaint_strength2 : AppRouter.inpaint_strength) + " / confidence=0.05";
    summary_line_5: "mask_blur=4 / inpaint_padding=32"; summary_line_6: root.node_id == "detail-2" ? AppRouter.detector_extra_args2 : AppRouter.detector_extra_args;
    summary_label_1: "Positive Prompt"; summary_label_2: "Negative Prompt";
    summary_line_1_height: 64px; summary_line_2_height: 64px;
    show_line_labels: true; body_line_count: 6; input_count: 2;
    input_1_label: "Image"; input_2_label: "Detector";
    input_1_type: "Image"; input_2_type: "Detector";
    input_1_color: #65a9ff; input_2_color: #fb923c;
    output_pin_label: "Image"; output_pin_type: "Image"; output_pin_color: #65a9ff; accent_color: #65a9ff;
}

export component ExtraWorkflowNode inherits NodePanel {
    node_kind: "Additional workflow node";
    summary_line_1: "Additional " + root.node_title;
    summary_line_2: "Drag to reposition or click to edit";
    summary_line_3: "Workflow node";
    body_line_count: 3;
    input_count: 0;
    output_pin_label: "Output";
    output_pin_type: "Any";
}
