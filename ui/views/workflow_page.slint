                        root.dragging = true;
                        root.drag_offset_x = drag_surface.mouse-x - detector_node.node_x;
                        root.drag_offset_y = drag_surface.mouse-y - detector_node.node_y;
                    }
                } else if detail_node.visible && drag_surface.mouse-x >= detail_node.node_x && drag_surface.mouse-x <= detail_node.node_x + detail_node.width && drag_surface.mouse-y >= detail_node.node_y && drag_surface.mouse-y <= detail_node.node_y + detail_node.height {
                    root.pressed_node = 6;
                    if drag_surface.mouse-y <= detail_node.node_y + 38px {
