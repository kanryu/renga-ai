                        root.drag_offset_y = drag_surface.mouse-y - save_node.node_y;
                    }
                } else if detector_node.visible && drag_surface.mouse-x >= detector_node.node_x && drag_surface.mouse-x <= detector_node.node_x + detector_node.width && drag_surface.mouse-y >= detector_node.node_y && drag_surface.mouse-y <= detector_node.node_y + detector_node.height {
                    root.pressed_node = 5;
                    if drag_surface.mouse-y <= detector_node.node_y + 38px {
