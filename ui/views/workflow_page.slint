                        root.drag_offset_y = drag_surface.mouse-y - detector2_node.node_y;
                    }
                } else if detail2_node.visible && drag_surface.mouse-x >= detail2_node.node_x && drag_surface.mouse-x <= detail2_node.node_x + detail2_node.width && drag_surface.mouse-y >= detail2_node.node_y && drag_surface.mouse-y <= detail2_node.node_y + detail2_node.height {
                    root.pressed_node = 13;
                    if drag_surface.mouse-y <= detail2_node.node_y + 38px {
                        WorkflowNodes.selected_id = "detail-2";
                        root.drag_node = 13;
                        root.dragging = true;
                        root.drag_offset_x = drag_surface.mouse-x - detail2_node.node_x;
                        root.drag_offset_y = drag_surface.mouse-y - detail2_node.node_y;
                    }
                }
            }
            if event.kind == PointerEventKind.up {
                if event.button != PointerEventButton.left { return; }
                if root.pressed_node >= 0 && root.drag_node < 0 {
                    if root.pressed_node == 0 { WorkflowNodes.open_node("ctx-1"); }
                    if root.pressed_node == 1 { WorkflowNodes.open_node("generate-1"); }
                    if root.pressed_node == 2 { WorkflowNodes.open_node("sample-1"); }
                    if root.pressed_node == 3 { WorkflowNodes.open_node("image-gen-1"); }
                    if root.pressed_node == 4 { WorkflowNodes.open_node("save-webp-1"); }
                    if root.pressed_node == 5 { WorkflowNodes.open_node("detector-1"); }
                    if root.pressed_node == 6 { WorkflowNodes.open_node("detail-1"); }
                    if root.pressed_node == 7 { WorkflowNodes.open_node("ctx-2"); }
                    if root.pressed_node == 8 { WorkflowNodes.open_node("generate-2"); }
                    if root.pressed_node == 9 { WorkflowNodes.open_node("sample-2"); }
                    if root.pressed_node == 10 { WorkflowNodes.open_node("image-gen-2"); }
                    if root.pressed_node == 11 { WorkflowNodes.open_node("save-webp-2"); }
                    if root.pressed_node == 12 { WorkflowNodes.open_node("detector-2"); }
                    if root.pressed_node == 13 { WorkflowNodes.open_node("detail-2"); }
                }
                root.dragging = false;
                root.drag_node = -1;
                root.pressed_node = -1;
            }
        }
        moved => {
            if root.node_panel_open && drag_surface.mouse-x < root.node_panel_width + 42px {
                return;
            }
            if drag_surface.pressed && root.drag_node >= 0 && !root.palette_dragging {
                if root.drag_node == 0 { ctx_node.node_x = drag_surface.mouse-x - root.drag_offset_x; ctx_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 1 { generate_node.node_x = drag_surface.mouse-x - root.drag_offset_x; generate_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 2 { sample_node.node_x = drag_surface.mouse-x - root.drag_offset_x; sample_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 3 { imggen_node.node_x = drag_surface.mouse-x - root.drag_offset_x; imggen_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 4 { save_node.node_x = drag_surface.mouse-x - root.drag_offset_x; save_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 5 { detector_node.node_x = drag_surface.mouse-x - root.drag_offset_x; detector_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 6 { detail_node.node_x = drag_surface.mouse-x - root.drag_offset_x; detail_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 7 { ctx2_node.node_x = drag_surface.mouse-x - root.drag_offset_x; ctx2_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 8 { generate2_node.node_x = drag_surface.mouse-x - root.drag_offset_x; generate2_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 9 { sample2_node.node_x = drag_surface.mouse-x - root.drag_offset_x; sample2_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 10 { imggen2_node.node_x = drag_surface.mouse-x - root.drag_offset_x; imggen2_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 11 { save2_node.node_x = drag_surface.mouse-x - root.drag_offset_x; save2_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 12 { detector2_node.node_x = drag_surface.mouse-x - root.drag_offset_x; detector2_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
                if root.drag_node == 13 { detail2_node.node_x = drag_surface.mouse-x - root.drag_offset_x; detail2_node.node_y = drag_surface.mouse-y - root.drag_offset_y; }
            }
        }
    }
    ctx_node := LoadModelNode { node_id: "ctx-1"; node_x <=> AppRouter.ctx_node_x; node_y <=> AppRouter.ctx_node_y; node_width <=> AppRouter.ctx_node_width; node_height <=> AppRouter.ctx_node_height; visible: WorkflowNodes.ctx_visible; }
    generate_node := GenerateImageNode { node_id: "generate-1"; node_x <=> AppRouter.generate_node_x; node_y <=> AppRouter.generate_node_y; node_width <=> AppRouter.generate_node_width; node_height <=> AppRouter.generate_node_height; visible: WorkflowNodes.generate_visible; }
    sample_node := SamplerSchedulerNode { node_id: "sample-1"; node_x <=> AppRouter.sample_node_x; node_y <=> AppRouter.sample_node_y; node_width <=> AppRouter.sample_node_width; node_height <=> AppRouter.sample_node_height; visible: WorkflowNodes.sample_visible; }
    imggen_node := PromptNode { node_id: "image-gen-1"; node_x <=> AppRouter.imggen_node_x; node_y <=> AppRouter.imggen_node_y; node_width <=> AppRouter.imggen_node_width; node_height <=> AppRouter.imggen_node_height; visible: WorkflowNodes.imggen_visible; }
    save_node := SaveImageNode { node_id: "save-webp-1"; node_x <=> AppRouter.save_node_x; node_y <=> AppRouter.save_node_y; node_width <=> AppRouter.save_node_width; node_height <=> AppRouter.save_node_height; visible: WorkflowNodes.save_visible; }
    detector_node := LoadDetectorNode { node_id: "detector-1"; node_x <=> AppRouter.detector_node_x; node_y <=> AppRouter.detector_node_y; node_width <=> AppRouter.detector_node_width; node_height <=> AppRouter.detector_node_height; visible: WorkflowNodes.detector_visible; }
    detail_node := DetailImageNode { node_id: "detail-1"; node_x <=> AppRouter.detail_node_x; node_y <=> AppRouter.detail_node_y; node_width <=> AppRouter.detail_node_width; node_height <=> AppRouter.detail_node_height; visible: WorkflowNodes.detail_visible; }
    ctx2_node := LoadModelNode { node_id: "ctx-2"; node_x <=> AppRouter.ctx2_node_x; node_y <=> AppRouter.ctx2_node_y; node_width: 230px; node_height: 162px; visible: AppRouter.ctx2_visible; }
    generate2_node := GenerateImageNode { node_id: "generate-2"; node_x <=> AppRouter.generate2_node_x; node_y <=> AppRouter.generate2_node_y; node_width: 230px; node_height: 162px; visible: AppRouter.generate2_visible; }
    sample2_node := SamplerSchedulerNode { node_id: "sample-2"; node_x <=> AppRouter.sample2_node_x; node_y <=> AppRouter.sample2_node_y; node_width: 230px; node_height: 162px; visible: AppRouter.sample2_visible; }
    imggen2_node := PromptNode { node_id: "image-gen-2"; node_x <=> AppRouter.imggen2_node_x; node_y <=> AppRouter.imggen2_node_y; node_width: 230px; node_height: 220px; visible: AppRouter.imggen2_visible; }
    save2_node := SaveImageNode { node_id: "save-webp-2"; node_x <=> AppRouter.save2_node_x; node_y <=> AppRouter.save2_node_y; node_width: 230px; node_height: 280px; visible: AppRouter.save2_visible; }
    detector2_node := LoadDetectorNode { node_id: "detector-2"; node_x <=> AppRouter.detector2_node_x; node_y <=> AppRouter.detector2_node_y; node_width: 230px; node_height: 162px; visible: AppRouter.detector2_visible; }
    detail2_node := DetailImageNode { node_id: "detail-2"; node_x <=> AppRouter.detail2_node_x; node_y <=> AppRouter.detail2_node_y; node_width: 230px; node_height: 360px; visible: AppRouter.detail2_visible; }
    detector_output_pin := TouchArea {
        x: detector_node.out_pin_x - 14px; y: detector_node.out_pin_y - 20px; width: 28px; height: 40px;
        mouse-cursor: root.wire_menu_visible ? default : crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.wire_menu_visible = false;
                root.wire_dragging = true; root.wire_source = 5;
                root.wire_start_x = detector_node.out_pin_x; root.wire_start_y = detector_node.out_pin_y;
                root.wire_end_x = detector_node.out_pin_x; root.wire_end_y = detector_node.out_pin_y;
            }
        }
        moved => {
            if root.wire_dragging {
                root.wire_end_x = detector_node.out_pin_x - 14px + detector_output_pin.mouse-x;
                root.wire_end_y = detector_node.out_pin_y - 20px + detector_output_pin.mouse-y;
            }
        }
    }
    detail_output_pin := TouchArea {
        x: detail_node.out_pin_x - 14px; y: detail_node.out_pin_y - 20px; width: 28px; height: 40px;
        mouse-cursor: root.wire_menu_visible ? default : crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.wire_menu_visible = false;
                root.wire_dragging = true; root.wire_source = 4;
                root.wire_start_x = detail_node.out_pin_x; root.wire_start_y = detail_node.out_pin_y;
                root.wire_end_x = detail_node.out_pin_x; root.wire_end_y = detail_node.out_pin_y;
            }
        }
        moved => {
            if root.wire_dragging {
                root.wire_end_x = detail_node.out_pin_x - 14px + detail_output_pin.mouse-x;
                root.wire_end_y = detail_node.out_pin_y - 20px + detail_output_pin.mouse-y;
            }
        }
    }
    wire_surface := TouchArea {
        visible: root.wire_dragging;
        width: parent.width;
        height: parent.height;
        mouse-cursor: root.wire_menu_visible ? default : crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.up {
                if event.button != PointerEventButton.left { return; }
                if root.wire_source == 0 && ctx_node.output_pin_type == generate_node.input_3_type && !root.ctx_to_generate && wire_surface.mouse-x >= generate_node.in_pin_3_x - 16px && wire_surface.mouse-x <= generate_node.in_pin_3_x + 16px && wire_surface.mouse-y >= generate_node.in_pin_3_y - 16px && wire_surface.mouse-y <= generate_node.in_pin_3_y + 16px {
                    root.ctx_to_generate = true;
                }
                if root.wire_source == 0 && ctx_node.output_pin_type == generate2_node.input_3_type && !root.ctx_to_generate2 && wire_surface.mouse-x >= generate2_node.in_pin_3_x - 16px && wire_surface.mouse-x <= generate2_node.in_pin_3_x + 16px && wire_surface.mouse-y >= generate2_node.in_pin_3_y - 16px && wire_surface.mouse-y <= generate2_node.in_pin_3_y + 16px {
                    root.ctx_to_generate2 = true;
                }
                if root.wire_source == 1 && generate_node.output_pin_type == detail_node.input_1_type && !root.generate_to_detail && wire_surface.mouse-x >= detail_node.in_pin_1_x - 16px && wire_surface.mouse-x <= detail_node.in_pin_1_x + 16px && wire_surface.mouse-y >= detail_node.in_pin_1_y - 16px && wire_surface.mouse-y <= detail_node.in_pin_1_y + 16px {
                    root.generate_to_detail = true;
                }
                if root.wire_source == 1 && generate_node.output_pin_type == detail2_node.input_1_type && !root.generate_to_detail2 && wire_surface.mouse-x >= detail2_node.in_pin_1_x - 16px && wire_surface.mouse-x <= detail2_node.in_pin_1_x + 16px && wire_surface.mouse-y >= detail2_node.in_pin_1_y - 16px && wire_surface.mouse-y <= detail2_node.in_pin_1_y + 16px {
                    root.generate_to_detail2 = true;
                }
                if root.wire_source == 1 && generate_node.output_pin_type == save_node.input_1_type && !root.generate_to_save && !root.detail_to_save && wire_surface.mouse-x >= save_node.in_pin_1_x - 16px && wire_surface.mouse-x <= save_node.in_pin_1_x + 16px && wire_surface.mouse-y >= save_node.in_pin_1_y - 16px && wire_surface.mouse-y <= save_node.in_pin_1_y + 16px {
                    root.generate_to_save = true;
                }
                if root.wire_source == 1 && generate_node.output_pin_type == save2_node.input_1_type && !root.generate_to_save2 && wire_surface.mouse-x >= save2_node.in_pin_1_x - 16px && wire_surface.mouse-x <= save2_node.in_pin_1_x + 16px && wire_surface.mouse-y >= save2_node.in_pin_1_y - 16px && wire_surface.mouse-y <= save2_node.in_pin_1_y + 16px {
                    root.generate_to_save2 = true;
                }
                if root.wire_source == 2 && sample_node.output_pin_type == generate_node.input_2_type && !root.sample_to_generate && wire_surface.mouse-x >= generate_node.in_pin_2_x - 16px && wire_surface.mouse-x <= generate_node.in_pin_2_x + 16px && wire_surface.mouse-y >= generate_node.in_pin_2_y - 16px && wire_surface.mouse-y <= generate_node.in_pin_2_y + 16px {
                    root.sample_to_generate = true;
                }
                if root.wire_source == 2 && sample_node.output_pin_type == generate2_node.input_2_type && !root.sample_to_generate2 && wire_surface.mouse-x >= generate2_node.in_pin_2_x - 16px && wire_surface.mouse-x <= generate2_node.in_pin_2_x + 16px && wire_surface.mouse-y >= generate2_node.in_pin_2_y - 16px && wire_surface.mouse-y <= generate2_node.in_pin_2_y + 16px {
                    root.sample_to_generate2 = true;
                }
                if root.wire_source == 3 && imggen_node.output_pin_type == generate_node.input_1_type && !root.imggen_to_generate && wire_surface.mouse-x >= generate_node.in_pin_1_x - 16px && wire_surface.mouse-x <= generate_node.in_pin_1_x + 16px && wire_surface.mouse-y >= generate_node.in_pin_1_y - 16px && wire_surface.mouse-y <= generate_node.in_pin_1_y + 16px {
                    root.imggen_to_generate = true;
                }
                if root.wire_source == 3 && imggen_node.output_pin_type == generate2_node.input_1_type && !root.imggen_to_generate2 && wire_surface.mouse-x >= generate2_node.in_pin_1_x - 16px && wire_surface.mouse-x <= generate2_node.in_pin_1_x + 16px && wire_surface.mouse-y >= generate2_node.in_pin_1_y - 16px && wire_surface.mouse-y <= generate2_node.in_pin_1_y + 16px {
                    root.imggen_to_generate2 = true;
                }
                if root.wire_source == 4 && detail_node.output_pin_type == save_node.input_1_type && !root.detail_to_save && !root.generate_to_save && wire_surface.mouse-x >= save_node.in_pin_1_x - 16px && wire_surface.mouse-x <= save_node.in_pin_1_x + 16px && wire_surface.mouse-y >= save_node.in_pin_1_y - 16px && wire_surface.mouse-y <= save_node.in_pin_1_y + 16px {
                    root.detail_to_save = true;
                }
                if root.wire_source == 4 && detail_node.output_pin_type == save2_node.input_1_type && !root.detail_to_save2 && wire_surface.mouse-x >= save2_node.in_pin_1_x - 16px && wire_surface.mouse-x <= save2_node.in_pin_1_x + 16px && wire_surface.mouse-y >= save2_node.in_pin_1_y - 16px && wire_surface.mouse-y <= save2_node.in_pin_1_y + 16px {
                    root.detail_to_save2 = true;
                }
                if root.wire_source == 5 && detector_node.output_pin_type == detail_node.input_2_type && !root.detector_to_detail && wire_surface.mouse-x >= detail_node.in_pin_2_x - 16px && wire_surface.mouse-x <= detail_node.in_pin_2_x + 16px && wire_surface.mouse-y >= detail_node.in_pin_2_y - 16px && wire_surface.mouse-y <= detail_node.in_pin_2_y + 16px {
                    root.detector_to_detail = true;
                }
                if root.wire_source == 5 && detector_node.output_pin_type == detail2_node.input_2_type && !root.detector_to_detail2 && wire_surface.mouse-x >= detail2_node.in_pin_2_x - 16px && wire_surface.mouse-x <= detail2_node.in_pin_2_x + 16px && wire_surface.mouse-y >= detail2_node.in_pin_2_y - 16px && wire_surface.mouse-y <= detail2_node.in_pin_2_y + 16px {
                    root.detector_to_detail2 = true;
                }
                root.wire_dragging = false;
                root.wire_source = -1;
            }
        }
        moved => {
            if root.wire_dragging {
                root.wire_end_x = wire_surface.mouse-x;
                root.wire_end_y = wire_surface.mouse-y;
            }
        }
    }
    ctx_output_pin := TouchArea {
        x: ctx_node.out_pin_x - 14px; y: ctx_node.out_pin_y - 20px; width: 28px; height: 40px;
        mouse-cursor: root.wire_menu_visible ? default : crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.wire_menu_visible = false;
                root.wire_dragging = true; root.wire_source = 0;
                root.wire_start_x = ctx_node.out_pin_x; root.wire_start_y = ctx_node.out_pin_y;
                root.wire_end_x = ctx_node.out_pin_x; root.wire_end_y = ctx_node.out_pin_y;
            }
        }
        moved => {
            if root.wire_dragging {
                root.wire_end_x = ctx_node.out_pin_x - 14px + ctx_output_pin.mouse-x;
                root.wire_end_y = ctx_node.out_pin_y - 20px + ctx_output_pin.mouse-y;
            }
        }
    }
    generate_output_pin := TouchArea {
        x: generate_node.out_pin_x - 14px; y: generate_node.out_pin_y - 20px; width: 28px; height: 40px;
        mouse-cursor: root.wire_menu_visible ? default : crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.wire_menu_visible = false;
                root.wire_dragging = true; root.wire_source = 1;
                root.wire_start_x = generate_node.out_pin_x; root.wire_start_y = generate_node.out_pin_y;
                root.wire_end_x = generate_node.out_pin_x; root.wire_end_y = generate_node.out_pin_y;
            }
        }
        moved => {
            if root.wire_dragging {
                root.wire_end_x = generate_node.out_pin_x - 14px + generate_output_pin.mouse-x;
                root.wire_end_y = generate_node.out_pin_y - 20px + generate_output_pin.mouse-y;
            }
        }
    }
    sample_output_pin := TouchArea {
        x: sample_node.out_pin_x - 14px; y: sample_node.out_pin_y - 20px; width: 28px; height: 40px;
        mouse-cursor: root.wire_menu_visible ? default : crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.wire_menu_visible = false;
                root.wire_dragging = true; root.wire_source = 2;
                root.wire_start_x = sample_node.out_pin_x; root.wire_start_y = sample_node.out_pin_y;
                root.wire_end_x = sample_node.out_pin_x; root.wire_end_y = sample_node.out_pin_y;
            }
        }
        moved => {
            if root.wire_dragging {
                root.wire_end_x = sample_node.out_pin_x - 14px + sample_output_pin.mouse-x;
                root.wire_end_y = sample_node.out_pin_y - 20px + sample_output_pin.mouse-y;
            }
        }
    }
    imggen_output_pin := TouchArea {
        x: imggen_node.out_pin_x - 14px; y: imggen_node.out_pin_y - 20px; width: 28px; height: 40px;
        mouse-cursor: root.wire_menu_visible ? default : crosshair;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.wire_menu_visible = false;
                root.wire_dragging = true; root.wire_source = 3;
                root.wire_start_x = imggen_node.out_pin_x; root.wire_start_y = imggen_node.out_pin_y;
                root.wire_end_x = imggen_node.out_pin_x; root.wire_end_y = imggen_node.out_pin_y;
            }
        }
        moved => {
            if root.wire_dragging {
                root.wire_end_x = imggen_node.out_pin_x - 14px + imggen_output_pin.mouse-x;
                root.wire_end_y = imggen_node.out_pin_y - 20px + imggen_output_pin.mouse-y;
            }
        }
    }
    BezierWire {
        visible: root.wire_dragging;
        start_x: root.wire_start_x;
        start_y: root.wire_start_y;
        end_x: root.wire_end_x;
        end_y: root.wire_end_y;
        wire_color: #f5f7fa;
    }
    Rectangle {
        visible: root.wire_menu_visible;
        x: root.wire_menu_x; y: root.wire_menu_y;
        width: 150px; height: 42px;
        background: #252a34; border-width: 1px; border-color: #667085; border-radius: 5px;
        Text { x: 12px; y: 12px; text: "Disconnect wire"; color: #f5f7fa; font-size: 13px; }
        TouchArea {
            mouse-cursor: default;
            clicked => {
                if root.wire_menu_wire == 0 { root.ctx_to_generate = false; }
                if root.wire_menu_wire == 1 { root.generate_to_detail = false; }
                if root.wire_menu_wire == 2 { root.sample_to_generate = false; }
                if root.wire_menu_wire == 3 { root.imggen_to_generate = false; }
                if root.wire_menu_wire == 4 { root.detail_to_save = false; }
                if root.wire_menu_wire == 5 { root.detector_to_detail = false; }
                if root.wire_menu_wire == 6 { root.generate_to_save = false; }
                root.wire_menu_visible = false;
                root.wire_menu_wire = -1;
            }
        }
    }
    Rectangle {
        visible: root.image_preview_open;
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #8080804d;
    }
    TouchArea {
        visible: root.image_preview_open;
        x: 0px; y: 0px; width: root.width; height: root.height;
        mouse-cursor: default;
        clicked => { root.image_preview_open = false; }
    }
    Image {
        visible: root.image_preview_open;
        x: 24px; y: 24px; width: root.width - 48px; height: root.height - 48px;
        source: AppRouter.image_preview_source == "secondary" ? AppRouter.output_images2[root.image_preview_index] : AppRouter.output_images[root.image_preview_index];
        image-fit: contain;
    }
    TouchArea {
        visible: root.image_preview_open;
        x: 24px; y: 24px; width: root.width - 48px; height: root.height - 48px;
        mouse-cursor: pointer;
        clicked => { root.image_preview_open = false; }
    }
    Rectangle {
        visible: root.node_panel_open;
        x: 42px; y: 0px; width: root.node_panel_width; height: parent.height;
        background: #20252e; border-width: 1px; border-color: #3f4652;
        Text { x: 16px; y: 18px; text: "Nodes"; color: #f5f7fa; font-size: 17px; font-weight: 700; }
        Text { x: 16px; y: 44px; text: "Drag a node into the workflow"; color: #9ca3af; font-size: 11px; }
        NodePaletteItem { x: 16px; y: 76px; item_name: "Load Model"; drag_start(name, start_x, start_y) => { root.palette_dragging = true; root.palette_drag_name = name; root.palette_drag_x = start_x; root.palette_drag_y = start_y; } drag_move(move_x, move_y) => { root.palette_drag_x = move_x; root.palette_drag_y = move_y; } drag_end(end_x, end_y) => { root.palette_drag_x = end_x; root.palette_drag_y = end_y; root.finish_palette_drop(); } }
        NodePaletteItem { x: 16px; y: 116px; item_name: "Sampler & Scheduler"; drag_start(name, start_x, start_y) => { root.palette_dragging = true; root.palette_drag_name = name; root.palette_drag_x = start_x; root.palette_drag_y = start_y; } drag_move(move_x, move_y) => { root.palette_drag_x = move_x; root.palette_drag_y = move_y; } drag_end(end_x, end_y) => { root.palette_drag_x = end_x; root.palette_drag_y = end_y; root.finish_palette_drop(); } }
        NodePaletteItem { x: 16px; y: 156px; item_name: "Prompt"; drag_start(name, start_x, start_y) => { root.palette_dragging = true; root.palette_drag_name = name; root.palette_drag_x = start_x; root.palette_drag_y = start_y; } drag_move(move_x, move_y) => { root.palette_drag_x = move_x; root.palette_drag_y = move_y; } drag_end(end_x, end_y) => { root.palette_drag_x = end_x; root.palette_drag_y = end_y; root.finish_palette_drop(); } }
        NodePaletteItem { x: 16px; y: 196px; item_name: "Generate Image"; drag_start(name, start_x, start_y) => { root.palette_dragging = true; root.palette_drag_name = name; root.palette_drag_x = start_x; root.palette_drag_y = start_y; } drag_move(move_x, move_y) => { root.palette_drag_x = move_x; root.palette_drag_y = move_y; } drag_end(end_x, end_y) => { root.palette_drag_x = end_x; root.palette_drag_y = end_y; root.finish_palette_drop(); } }
        NodePaletteItem { x: 16px; y: 236px; item_name: "Load Detector"; drag_start(name, start_x, start_y) => { root.palette_dragging = true; root.palette_drag_name = name; root.palette_drag_x = start_x; root.palette_drag_y = start_y; } drag_move(move_x, move_y) => { root.palette_drag_x = move_x; root.palette_drag_y = move_y; } drag_end(end_x, end_y) => { root.palette_drag_x = end_x; root.palette_drag_y = end_y; root.finish_palette_drop(); } }
        NodePaletteItem { x: 16px; y: 276px; item_name: "Detail Image"; drag_start(name, start_x, start_y) => { root.palette_dragging = true; root.palette_drag_name = name; root.palette_drag_x = start_x; root.palette_drag_y = start_y; } drag_move(move_x, move_y) => { root.palette_drag_x = move_x; root.palette_drag_y = move_y; } drag_end(end_x, end_y) => { root.palette_drag_x = end_x; root.palette_drag_y = end_y; root.finish_palette_drop(); } }
        NodePaletteItem { x: 16px; y: 316px; item_name: "Save Image"; drag_start(name, start_x, start_y) => { root.palette_dragging = true; root.palette_drag_name = name; root.palette_drag_x = start_x; root.palette_drag_y = start_y; } drag_move(move_x, move_y) => { root.palette_drag_x = move_x; root.palette_drag_y = move_y; } drag_end(end_x, end_y) => { root.palette_drag_x = end_x; root.palette_drag_y = end_y; root.finish_palette_drop(); } }
        TouchArea { x: root.node_panel_width - 4px; y: 0px; width: 8px; height: parent.height; mouse-cursor: ew-resize; moved => { if self.pressed { root.node_panel_width = Math.max(220px, Math.min(420px, self.mouse-x + root.node_panel_width)); } } }
    }
    Rectangle {
        x: 0px; y: 0px; width: 42px; height: parent.height;
        background: #20252e; border-width: 1px; border-color: #3f4652;
        Button { x: 5px; y: 68px; width: 32px; height: 76px; text: "N"; clicked => { root.node_panel_open = !root.node_panel_open; } }
    }
    TouchArea {
        visible: root.palette_dragging;
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        mouse-cursor: grabbing;
        moved => { root.palette_drag_x = self.mouse-x; root.palette_drag_y = self.mouse-y; }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up {
                if root.palette_drag_x > root.node_panel_width + 42px {
                    WorkflowNodes.drop_x = Math.max(42px, root.palette_drag_x - 115px);
                    WorkflowNodes.drop_y = Math.max(0px, root.palette_drag_y - 20px);
                    WorkflowNodes.add_node(root.palette_drag_name);
                }
                root.palette_dragging = false;
                root.palette_drag_name = "";
            }
        }
    }
    if root.palette_dragging: Rectangle {
        x: root.palette_drag_x - 90px; y: root.palette_drag_y - 17px; width: 180px; height: 34px;
        background: #3d618b; border-radius: 4px;
        Text { x: 10px; y: 9px; text: root.palette_drag_name; color: #ffffff; font-size: 12px; }
    }
    Rectangle {
        visible: AppRouter.workflow_running;
        x: 18px;
        y: parent.height - 92px;
        width: parent.width - 36px;
        height: 72px;
        background: #20242cdd;
        border-width: 1px;
        border-color: #3f4652;
        border-radius: 6px;
        Text {
            x: 12px; y: 8px; width: 260px; height: 18px;
            text: AppRouter.workflow_stage;
            color: #e5e7eb; font-size: 12px;
        }
        Text {
            x: 280px; y: 8px; width: 120px; height: 18px;
            text: AppRouter.workflow_step + " / " + AppRouter.workflow_steps;
            color: #9ca3af; font-size: 11px;
            horizontal-alignment: right;
        }
        Rectangle { x: 12px; y: 28px; width: parent.width - 24px; height: 8px; background: #11151b; border-radius: 4px;
            Rectangle { x: 0px; width: parent.width * (AppRouter.workflow_steps > 0 ? AppRouter.workflow_step / AppRouter.workflow_steps : 0); height: 100%; background: #60a5fa; border-radius: 4px; }
        }
        Text {
            x: 12px; y: 43px; width: 260px; height: 18px;
            text: "Overall progress";
            color: #9ca3af; font-size: 11px;
        }
        Text {
            x: 280px; y: 43px; width: 120px; height: 18px;
            text: AppRouter.workflow_overall_step + "%";
            color: #9ca3af; font-size: 11px;
            horizontal-alignment: right;
        }
        Rectangle { x: 12px; y: 62px; width: parent.width - 24px; height: 8px; background: #11151b; border-radius: 4px;
            Rectangle { x: 0px; width: parent.width * (AppRouter.workflow_overall_steps > 0 ? AppRouter.workflow_overall_step / AppRouter.workflow_overall_steps : 0); height: 100%; background: #a78bfa; border-radius: 4px; }
        }
    }
    Button {
        x: parent.width - self.width - 24px;
        y: 18px;
        text: "Back to Home";
        clicked => { AppRouter.navigate("Home"); }
    }
    Button {
        x: parent.width - self.width - 150px;
        y: 18px;
        text: "Save Workflow";
        clicked => { AppRouter.save_workflow(); }
    }
    Button {
        x: parent.width - self.width - 270px;
        y: 18px;
        text: "Run";
        clicked => { AppRouter.run_workflow(); }
    }
}
