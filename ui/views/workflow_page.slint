                        root.drag_node = 6;
                        root.dragging = true;
                        root.drag_offset_x = drag_surface.mouse-x - detail_node.node_x;
                        root.drag_offset_y = drag_surface.mouse-y - detail_node.node_y;
                    }
                } else if ctx2_node.visible && drag_surface.mouse-x >= ctx2_node.node_x && drag_surface.mouse-x <= ctx2_node.node_x + ctx2_node.width && drag_surface.mouse-y >= ctx2_node.node_y && drag_surface.mouse-y <= ctx2_node.node_y + ctx2_node.height {
                    root.pressed_node = 7;
                    if drag_surface.mouse-y <= ctx2_node.node_y + 38px {
                        WorkflowNodes.selected_id = "ctx-2";
                        root.drag_node = 7;
                        root.dragging = true;
                        root.drag_offset_x = drag_surface.mouse-x - ctx2_node.node_x;
