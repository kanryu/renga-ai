                    root.pressed_node = 8;
                    if drag_surface.mouse-y <= generate2_node.node_y + 38px {
                        WorkflowNodes.selected_id = "generate-2";
                        root.drag_node = 8;
                        root.dragging = true;
                        root.drag_offset_x = drag_surface.mouse-x - generate2_node.node_x;
                        root.drag_offset_y = drag_surface.mouse-y - generate2_node.node_y;
                    }
                } else if sample2_node.visible && drag_surface.mouse-x >= sample2_node.node_x && drag_surface.mouse-x <= sample2_node.node_x + sample2_node.width && drag_surface.mouse-y >= sample2_node.node_y && drag_surface.mouse-y <= sample2_node.node_y + sample2_node.height {
