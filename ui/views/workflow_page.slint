                    root.pressed_node = 11;
                    if drag_surface.mouse-y <= save2_node.node_y + 38px {
                        WorkflowNodes.selected_id = "save-webp-2";
                        root.drag_node = 11;
                        root.dragging = true;
                        root.drag_offset_x = drag_surface.mouse-x - save2_node.node_x;
                        root.drag_offset_y = drag_surface.mouse-y - save2_node.node_y;
                    }
                } else if detector2_node.visible && drag_surface.mouse-x >= detector2_node.node_x && drag_surface.mouse-x <= detector2_node.node_x + detector2_node.width && drag_surface.mouse-y >= detector2_node.node_y && drag_surface.mouse-y <= detector2_node.node_y + detector2_node.height {
                    root.pressed_node = 12;
                    if drag_surface.mouse-y <= detector2_node.node_y + 38px {
                        WorkflowNodes.selected_id = "detector-2";
