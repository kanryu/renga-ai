import { Button, VerticalBox } from "std-widgets.slint";
import { AppRouter } from "../renga/router.slint";

component SettingsPage inherits VerticalBox {
    alignment: center;
    spacing: 12px;
    Text {
        text: "Settings";
        font-size: 24px;
        horizontal-alignment: center;
    }
    Text {
        text: "Runtime and plugin settings will be configured here.";
        horizontal-alignment: center;
    }
    Button {
        text: "Back to Home";
        clicked => { AppRouter.navigate("Home"); }
    }
}
